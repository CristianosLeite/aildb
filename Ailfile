# aildb: a local, file-based vector search engine (README.md). A program
# that uses it names it as a dependency and reads its library, for one
#   use "aildb:src/lib/search.aiw"
# (docs/library.md).
name aildb
version 0.1.1
ail 0.1.1

# what is shipped: the commands build, search and check
bin aildb src/aildb.aiw

# built for the tests: the commands with hooks that stop a build where a
# test asks, the chunker of the example, its check and the evaluation
# of docs/evaluation.md
testbin aildb-stops tests/lib/stops.aiw
testbin chunk example/chunk.aiw
testbin embed example/embed.aiw
testbin embed-fake tests/lib/embedfake.aiw
testbin example-check example/check.aiw
testbin example-eval example/eval.aiw
