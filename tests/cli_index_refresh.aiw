# aildb index refreshes an index and asks the provider only for what it
# has no vector of, which provider.log of build/provider-fake shows. A
# run over files that did not change asks for nothing and writes
# nothing; a file that was only touched is read and found the same; an
# edit of one file asks for its changed chunk alone; a file that was
# moved and one that was copied ask for nothing, and the records have
# the new paths; with the last file removed the snapshot has no record.
# Another setting of the provider is another identity: every text is
# asked for again and the vectors of the first are removed, and so is
# another argument of its command, while another time for a request and
# another path of its program change nothing. A provider that fails at
# its second request leaves the snapshot that was there, and the run
# after it asks only for what the first did not get. Without the kept
# vectors everything is asked for again, without the manifest nothing
# is, and a snapshot that is not the one of the manifest is replaced.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "lib/std/proc.aiw"
use "tests/lib/cmd.aiw"
use "tests/lib/dir.aiw"
# what changed in .aildb since the file mark was made, and the sum of
# the snapshot
fn since
	call dirsh "find p/.aildb -newer mark | sort\ncksum < p/.aildb/index\n"
end
call print "# three files, five chunks\n"
call dirsh "mkdir -p p/sub\nprintf '# One\\nfirst\\n\\n# Two\\nsecond\\n' > p/a.md\nprintf 'x = 1\\n' > p/sub/b.py\nprintf 'alpha\\n\\n\\n' > p/c.txt\nprintf '# Other\\nthird\\n' > p/d.md\n"
call dirrun "index p -i m1 -d 3 -b 2 -- FAKE"
call dirasked
call dirsh "ls p/.aildb p/.aildb/cache\nsleep 0.05\ntouch mark\nsleep 0.05\n"
call since
call print "# nothing changed: nothing asked, nothing written\n"
call dirrun "index p"
call dirasked
call since
call print "# a file touched: read again, the manifest alone written\n"
call dirsh "touch p/a.md\n"
call dirrun "index p"
call dirasked
call since
call print "# one section of a file edited: one text asked for\n"
call dirsh "printf '# One\\nfirst\\n\\n# Two\\nanother\\n' > p/a.md\n"
call dirrun "index p"
call dirasked
call dirhits "p"
call print "# a file moved and a file copied: nothing asked, new paths\n"
call dirsh "mkdir p/docs\nmv p/a.md p/docs/z.md\ncp p/sub/b.py p/copy.py\n"
call dirrun "index p"
call dirasked
call dirhits "p"
call print "# the same text in a new file with another language, and twice in one run\n"
call dirsh "printf 'new\\n' > p/n1.txt\nprintf 'new\\n' > p/n2.txt\nprintf 'x = 1\\n' > p/b.rb\n"
call dirrun "index p"
call dirasked
call print "# the last file removed\n"
call dirsh "mv p/.aildb kept\nmkdir q\nmv p/* q/\nmv kept p/.aildb\n"
call dirrun "index p"
call dirasked
call dirrun "check p/.aildb/index"
call dirsh "mv q/* p/\nrmdir q\n"
call dirrun "index p"
call dirasked
call print "# another time for a request: the same identity, nothing asked\n"
call dirrun "index p -i m1 -d 3 -b 2 -t 5000 -- FAKE"
call dirasked
call dirsh "ls p/.aildb/cache\n"
call print "# another setting: another identity, all asked, the old vectors removed\n"
call dirrun "index p -i m1 -d 3 -b 4 -s document_prefix=d: -- FAKE"
call dirasked
call dirsh "ls p/.aildb/cache\n"
call print "# another argument of the command: another identity too\n"
call dirrun "index p -i m1 -d 3 -b 4 -s document_prefix=d: -- FAKE spread"
call dirasked
call dirsh "ls p/.aildb/cache\n"
call dirhits "p"
call print "# and another program with the same arguments: the same identity\n"
call dirsh "ln -s / up\n"
call dirrun "index p -i m1 -d 3 -b 4 -s document_prefix=d: -- up/FAKE spread"
call dirasked
call dirsh "ls p/.aildb/cache\n"
call print "# a provider that fails at its second request: the snapshot stays\n"
call dirsh "cksum < p/.aildb/index\n"
call dirsh "printf after1 > provider.fault\n"
call dirrun "index p -i m1 -d 3 -b 3 -s document_prefix=e: -- FAKE"
call dirsh "rm provider.fault\ncksum < p/.aildb/index\nls p/.aildb/cache | wc -l\n"
call dirasked
call print "# the run after it asks for the rest\n"
call dirrun "index p -i m1 -d 3 -b 3 -s document_prefix=e: -- FAKE"
call dirasked
call dirsh "ls p/.aildb/cache | wc -l\n"
call print "# the kept vectors lost: all asked, the snapshot the same\n"
call dirsh "cksum < p/.aildb/index\nrm p/.aildb/cache/*\n"
call dirrun "index p"
call dirasked
call dirsh "cksum < p/.aildb/index\n"
call print "# the manifest lost, and one that is no manifest: nothing asked\n"
call dirsh "rm p/.aildb/manifest\n"
call dirrun "index p"
call dirsh "printf 'no manifest\\n' > p/.aildb/manifest\n"
call dirrun "index p"
call dirrun "index p"
call dirasked
call print "# a snapshot that is not the one of the manifest\n"
call dirsh "printf 'only\\n' > only.txt\nmkdir o\nmv only.txt o/\n"
call dirrun "index o -i m1 -d 3 -b 3 -s document_prefix=e: -- FAKE"
call dirasked
call dirsh "cp o/.aildb/index p/.aildb/index\n"
call dirrun "check p/.aildb/index"
call dirrun "index p"
call dirasked
call dirrun "check p/.aildb/index"
call dirrun "index p"
