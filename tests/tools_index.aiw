# tools/index.sh, the index of a repository (make index), on a
# repository of git that the test makes, against the service that
# answers as Ollama does (tests/lib/embedfake.aiw): the index of HEAD,
# with the name of the revision as git says it; after another commit and
# with a file that is not committed, the index replaced; an older
# revision by its name, into a directory that is not there; a repository
# whose files are not what an archive or a list of names would give (a
# path that is not ASCII, a directory with a space, a document that
# export-ignore keeps out of an archive, a symbolic link to a document
# outside the repository, a path that git quotes, a file that is not
# text and one of more bytes than are read); and what cannot be done: a
# revision and a repository that are not there, a repository with no
# text in it, wrong usage, and a service that is
# gone, after which the index is the one that was there and nothing
# else is left beside it.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "lib/std/proc.aiw"
use "tests/lib/cmd.aiw"
buf b 24
buf line 24
buf ts 16
var port
# run tools/index.sh with the arguments p n and show what it did
fn index p n
	call bycut line 0
	call byadd line "/usr/bin/env OLLAMA_HOST=127.0.0.1:"
	call byaddn line port
	call byadd line " /bin/sh "
	call byadd line cmdhome cmdhomen
	call byadd line "/tools/index.sh"
	if n
		call byaddb line 32
		call byadd line p n
	end
	load line as q
	load line+8 as m
	call cmdargs q m as av
	call cmdrun av -1 cmdso cmdse as st
	call print "$ tools/index.sh "
	call print p n
	call print "\n"
	load cmdso as q
	load cmdso+8 as m
	call print q m
	load cmdse as q
	load cmdse+8 as m
	call print q m
	call print "status "
	call putn st
	call print "\n"
end
# run the lines p n with sh; they say nothing unless they fail
fn sh p n
	call filewrite "step.sh" p n
	call cmdargs "/bin/sh -e step.sh" as av
	call cmdrun av -1 cmdso cmdse as st
	load cmdse as q
	load cmdse+8 as m
	call print q m
	if st
		call print "a step failed\n"
	end
end
call cmdspawn "embed-fake port.txt" as fake
call cmdawait "port.txt" 5000 as r
store ts 0
store ts+8 20000000
sys nanosleep ts 0
call fileread "port.txt" b
load b as p
load b+8 as n
i=0
while i<n
	loadb p+i as c
	port=port*10+c-48
	i+=1
end
# The settings of git are those of nobody and the dates are fixed, so a
# commit has the same name wherever the test runs.
call filewrite "git.sh" "export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1\nexport GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com\nexport GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com\nexport GIT_AUTHOR_DATE=2026-01-01T00:00:00Z GIT_COMMITTER_DATE=2026-01-01T00:00:00Z\n"

call print "# two functions, two sections and a file of text\n"
call sh ". ./git.sh\ngit init -q r\nprintf 'fn a\\n\\tret 0\\nend\\nfn b\\n\\tret 1\\nend\\n' > r/a.aiw\nprintf '# One\\nfirst\\n## Two\\nsecond\\n' > r/README.md\nprintf 'nothing\\n' > r/x.txt\ngit -C r add .\ngit -C r commit -q -m one\n"
call index "r o/r.idx"
call cmdshow "/usr/bin/env git -C r rev-parse HEAD"
call cmdshow "aildb check o/r.idx"

call print "# another commit, and a file that is not committed\n"
call sh ". ./git.sh\nmkdir r/docs\nprintf '# Three\\nthird\\n' > r/docs/b.md\ngit -C r add .\ngit -C r commit -q -m two\nprintf '# Four\\nfourth\\n' > r/c.md\n"
call index "r o/r.idx"
call cmdshow "/usr/bin/env git -C r rev-parse HEAD"
call cmdshow "aildb check o/r.idx"

call print "# the revision before, into a directory that is not there\n"
call index "r o/d/one.idx HEAD~1"
call cmdshow "aildb check o/d/one.idx"

call print "# a document that is not ASCII, a source in \"a b\", export-ignore, a link, a quote, no text, too long\n"
call sh ". ./git.sh\ngit init -q s\nprintf '# Out\\nnot of the repository\\n' > out.md\nmkdir s/docs 's/a b'\nprintf '# Five\\nfifth\\n' > 's/docs/r\xc3\xa9sum\xc3\xa9.md'\nprintf 'fn c\\n\\tret 2\\nend\\n' > 's/a b/c.aiw'\nprintf 'docs/** export-ignore\\n' > s/.gitattributes\nln -s ../out.md s/link.md\nprintf '# Six\\nsixth\\n' > 's/q\".md'\nprintf 'a\\0b' > s/bin.dat\nhead -c 1048577 /dev/zero | tr '\\0' x > s/long.txt\ngit -C s add .\ngit -C s commit -q -m one\n"
call index "s o/s.idx"
call cmdshow "aildb check o/s.idx"

call print "# what cannot be done\n"
call index "r o/bad.idx absent"
call index "absent o/bad.idx"
call sh ". ./git.sh\ngit init -q e\nprintf 'a\\0b' > e/x.txt\ngit -C e add .\ngit -C e commit -q -m one\n"
call index "e o/bad.idx"
call index "r"
call index "r o/bad.idx HEAD more"
sys kill fake 9
call procwait fake 0 as r
call index "r o/r.idx HEAD~1"
call cmdshow "aildb check o/r.idx"
call cmdshow "/usr/bin/env LC_ALL=C ls o o/d"
