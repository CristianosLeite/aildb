# the functions of src/lib/text.aiw: numbers with their limits, lines
# and fields, equality and prefixes, which bytes are a valid string and
# which well-formed UTF-8;
# the expected answers for UTF-8 are those of Python 3's decoder
use "lib/std/io.aiw"
use "src/lib/text.aiw"
fn num p n
	call textnum p n as v ok
	call putn v
	call print " "
	call putn ok
	call print "\n"
end
fn two a b
	call putn a
	call print " "
	call putn b
	call print "\n"
end
fn one a
	call putn a
	call print "\n"
end
