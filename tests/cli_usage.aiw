# without a command, and with one that is none, aildb prints its usage on
# stderr, nothing on stdout, and ends with the status of wrong usage
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "lib/std/proc.aiw"
use "tests/lib/cmd.aiw"
call cmdshow "aildb"
call cmdshow "aildb frob"
call cmdshow "aildb frob a b"
# the same through the arguments one by one, of which one has a space and
# one is empty
call cmdbegin
call cmdadd "aildb"
call cmdadd "frob a"
call cmdadd ""
call cmdadd "b"
call cmdshowv
