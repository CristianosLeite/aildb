# AIL: a function starts a chunk, with the comment above it
$ chunk . meta.tsv text.jsonl < list.txt
--- stdout
1 files, 4 chunks
--- stderr
--- status 0
--- meta.tsv
lib/a.aiw	1	2	ail
lib/a.aiw	4	8	ail
lib/a.aiw	9	17	ail
lib/a.aiw	19	21	ail
--- text.jsonl
"# a.aiw -- two functions\u000ause \"x.aiw\""
"# the first,\u000a# with two lines of comment\u000afn one a\u000a\u0009ret a\u000aend"
"fn two a\u000a\u0009# a comment inside\u000a\u0009ret a\u000aend\u000a\u000a\u000a# no function follows\u000avar v\u000a# the third"
"fn three\u000aend\u000acall one 1"

# Markdown: a heading starts a chunk, a line in a fence does not
$ chunk . meta.tsv text.jsonl < list.txt
--- stdout
1 files, 3 chunks
--- stderr
--- status 0
--- meta.tsv
doc.md	1	1	markdown
doc.md	3	11	markdown
doc.md	12	15	markdown
--- text.jsonl
"intro"
"# Title\u000a\u000atext \\ \"quoted\"\u000a```\u000a# a comment of AIL\u000afn x\u000a```\u000a#no heading\u000a####### seven"
"## Second\u000a   \u000a\u0009\u000alast"

# forty lines at most; blank lines at the ends belong to no chunk
