""
""
"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"

# files without a chunk, carriage returns, paths that are passed over
$ chunk . meta.tsv text.jsonl < list.txt
--- stdout
4 files, 6 chunks
--- stderr
--- status 0
--- meta.tsv
crlf.aiw	1	2	ail
crlf.aiw	4	5	ail
lib/a.aiw	1	2	ail
lib/a.aiw	4	8	ail
lib/a.aiw	9	17	ail
lib/a.aiw	19	21	ail
--- text.jsonl
"fn a\u000d\u000aend\u000d"
"fn b\u000d\u000aend\u000d"
"# a.aiw -- two functions\u000ause \"x.aiw\""
"# the first,\u000a# with two lines of comment\u000afn one a\u000a\u0009ret a\u000aend"
"fn two a\u000a\u0009# a comment inside\u000a\u0009ret a\u000aend\u000a\u000a\u000a# no function follows\u000avar v\u000a# the third"
"fn three\u000aend\u000acall one 1"

# what it refuses
$ chunk . meta.tsv
--- stdout
--- stderr
usage: chunk ROOT META TEXT < LIST
--- status 2
$ chunk . meta.tsv text.jsonl < list.txt
--- stdout
--- stderr
chunk: cannot read ./lib/none.aiw
--- status 4
--- meta.tsv
--- text.jsonl
$ chunk . meta.tsv text.jsonl < list.txt
