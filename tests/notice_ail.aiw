# NOTICE has the licence of AIL as the AIL repository has it: the file
# ail/LICENSE, every byte, is in it. An executable of aildb has code of
# the library of AIL in it, and the notice is what goes with one.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "src/lib/text.aiw"
buf a 24
buf b 24
call fileread "NOTICE" a as r
call fileread "ail/LICENSE" b as s
ifslt r|s 0
	call die "cannot read NOTICE or ail/LICENSE\n"
end
load a as p
load a+8 as n
load b as q
load b+8 as m
found=0
i=0
while i+m<=n
	call texteq p+i m q m as same
	if same
		found=1
		i=n
	end
	i+=1
end
call print "the licence of AIL has bytes: "
call putn m>0
call print "\nNOTICE has all of them: "
call putn found
call print "\n"
