# NOTICE has the licence of AIL as AIL has it: the file LICENSE of the
# AIL this package is built with, every byte, is in it. "ail test" names
# the directory of that AIL in AIL_HOME. An executable of aildb has code
# of the library of AIL in it, and the notice is what goes with one.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "lib/std/proc.aiw"
use "src/lib/text.aiw"
buf a 24
buf b 24
buf path 24
call procvar "AIL_HOME" as p n
call byadd path p n
call byadd path "/LICENSE"
load path as p
load path+8 as n
call fileread "NOTICE" a as r
call fileread p n b as s
ifslt r|s 0
	call die "cannot read NOTICE or the LICENSE of AIL\n"
end
load a as p
load a+8 as n
load b as q
load b+8 as m
found=0
i=0
while i+m<=n
	call texteq p+i m q m as same
	if same
		found=1
		i=n
	end
	i+=1
end
call print "the licence of AIL has bytes: "
call putn m>0
call print "\nNOTICE has all of them: "
call putn found
call print "\n"
