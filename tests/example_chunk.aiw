call filewrite "Wide.PDF" "%PDF-1.4\x0a1 0 obj\x0a<</Type /Catalog /Pages 2 0 R>>\x0aendobj\x0a3 0 obj\x0a<</Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding /FirstChar 32 /LastChar 126 /Widths [500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500]>>\x0aendobj\x0a10 0 obj\x0a<< /Length 1644>>\x0astream\x0aBT /F1 10 Tf 72 700 Td 12 TL () ' (end) ' ET\x0aendstream\x0aendobj\x0a11 0 obj\x0a<</Type /Page /Parent 2 0 R /Contents 10 0 R>>\x0aendobj\x0a2 0 obj\x0a<</Type /Pages /Count 1 /Kids [11 0 R] /Resources <</Font <</F1 3 0 R>> /XObject <<>>>>>>\x0aendobj\x0axref\x0a0 4\x0a0000000000 65535 f \x0a0000000009 00000 n \x0a0000002328 00000 n \x0a0000000056 00000 n \x0a10 2\x0a0000000569 00000 n \x0a0000002265 00000 n \x0atrailer\x0a<</Size 12 /Root 1 0 R>>\x0astartxref\x0a2433\x0a%%EOF\x0a"
call filewrite "mid.pdf" "%PDF-1.4\x0a1 0 obj\x0a<</Type /Catalog /Pages 2 0 R>>\x0aendobj\x0a3 0 obj\x0a<</Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding /FirstChar 32 /LastChar 126 /Widths [500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500]>>\x0aendobj\x0a10 0 obj\x0a<< /Length 42>>\x0astream\x0aBT /F1 10 Tf 72 700 Td 12 TL (before) ' ET\x0aendstream\x0aendobj\x0a11 0 obj\x0a<</Type /Page /Parent 2 0 R /Contents 10 0 R>>\x0aendobj\x0a12 0 obj\x0a<</Filter /DCTDecode /Length 1>>\x0astream\x0ax\x0aendstream\x0aendobj\x0a13 0 obj\x0a<</Type /Page /Parent 2 0 R /Contents 12 0 R>>\x0aendobj\x0a14 0 obj\x0a<< /Length 29>>\x0astream\x0aBT /F1 10 Tf (not ended Tj ET\x0aendstream\x0aendobj\x0a15 0 obj\x0a<</Type /Page /Parent 2 0 R /Contents 14 0 R>>\x0aendobj\x0a16 0 obj\x0a<< /Length 41>>\x0astream\x0aBT /F1 10 Tf 72 700 Td 12 TL (after) ' ET\x0aendstream\x0aendobj\x0a17 0 obj\x0a<</Type /Page /Parent 2 0 R /Contents 16 0 R>>\x0aendobj\x0a2 0 obj\x0a<</Type /Pages /Count 4 /Kids [11 0 R 13 0 R 15 0 R 17 0 R] /Resources <</Font <</F1 3 0 R>> /XObject <<>>>>>>\x0aendobj\x0axref\x0a0 4\x0a0000000000 65535 f \x0a0000000009 00000 n \x0a0000001151 00000 n \x0a0000000056 00000 n \x0a10 8\x0a0000000569 00000 n \x0a0000000661 00000 n \x0a0000000724 00000 n \x0a0000000792 00000 n \x0a0000000855 00000 n \x0a0000000934 00000 n \x0a0000000997 00000 n \x0a0000001088 00000 n \x0atrailer\x0a<</Size 18 /Root 1 0 R>>\x0astartxref\x0a1277\x0a%%EOF\x0a"
