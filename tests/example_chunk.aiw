call filewrite "fake.pdf" "no header\x0a"
call filewrite "named.txt" "%PDF-1.4\x0aunder another name\x0a"
call filewrite "empty.pdf" "%PDF-1.4\x0a1 0 obj\x0a<</Type /Catalog /Pages 2 0 R>>\x0aendobj\x0a3 0 obj\x0a<</Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding /FirstChar 32 /LastChar 126 /Widths [500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500 500]>>\x0aendobj\x0a10 0 obj\x0a<< /Length 3>>\x0astream\x0aq Q\x0aendstream\x0aendobj\x0a11 0 obj\x0a<</Type /Page /Parent 2 0 R /Contents 10 0 R>>\x0aendobj\x0a2 0 obj\x0a<</Type /Pages /Count 1 /Kids [11 0 R] /Resources <</Font <</F1 3 0 R>> /XObject <<>>>>>>\x0aendobj\x0axref\x0a0 4\x0a0000000000 65535 f \x0a0000000009 00000 n \x0a0000000684 00000 n \x0a0000000056 00000 n \x0a10 2\x0a0000000569 00000 n \x0a0000000621 00000 n \x0atrailer\x0a<</Size 12 /Root 1 0 R>>\x0astartxref\x0a789\x0a%%EOF\x0a"
call filewrite "list.txt" "two.pdf\nWide.PDF\nmid.pdf\nlocked.pdf\nbroken.pdf\nspent.pdf\nfake.pdf\nnamed.txt\nempty.pdf\n"
call all 1

call print "\n# what it refuses\n"
call cmdshow "chunk . meta.tsv"
call cmdshow "chunk -c . meta.tsv"
call cmdshow "chunk -c . meta.tsv text.jsonl more"
call filewrite "list.txt" "notes.txt\nnone.txt\n"
call all 1
call filewrite "list.txt" "lib/a.aiw\nlib/none.aiw\n"
call run
call filewrite "list.txt" "../lib/a.aiw\n"
call run
call filewrite "list.txt" "li\x01b/a.aiw\n"
call run
call filewrite "list.txt" "/etc/a.md\n"
call run
call filewrite "list.txt" "lib/a.aiw\n"
call cmdshowin "chunk . none/meta.tsv text.jsonl" "list.txt"
