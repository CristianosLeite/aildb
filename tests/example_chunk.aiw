# the chunker, build/chunk: how it cuts a source of AIL and a Markdown
# file into chunks, as docs/example.md says, the lines of metadata and of
# text it writes, and what it says of wrong arguments, a path that build
# would not take and a file that is not there. The first cases are run
# with -c, as the corpora of the example are; then come the files that
# are taken without it: every text file with the language its name
# says, what is not text, a line longer than a chunk, a file of the
# most bytes that are read, and PDF files, written for the test by a
# Python program that also wrote what their pages are to give: chunks
# with the number of the page, a page and a file that cannot be read,
# and a file that is spent after a page of it was cut.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "lib/std/proc.aiw"
use "tests/lib/cmd.aiw"
buf b 24
buf f 24
# print what the chunker wrote; text says whether the lines of text too
fn wrote text
	call bycut b 0
	call fileread "meta.tsv" b
	call print "--- meta.tsv\n"
	load b as p
	load b+8 as n
	call print p n
	if text
		call bycut b 0
		call fileread "text.jsonl" b
		call print "--- text.jsonl\n"
		load b as p
		load b+8 as n
		call print p n
	end
end
# run the chunker with -c on the list at list.txt and print what it wrote
fn run
	call fileunlink "meta.tsv"
	call fileunlink "text.jsonl"
	call cmdshowin "chunk -c . meta.tsv text.jsonl" "list.txt"
	call wrote 1
end
# the same without -c
fn all text
	call fileunlink "meta.tsv"
	call fileunlink "text.jsonl"
	call cmdshowin "chunk . meta.tsv text.jsonl" "list.txt"
	call wrote text
end
# write the bytes of f to the file at p n and empty f
fn save p n
	load f as q
	load f+8 as m
	call filewrite p n q m
	call bycut f 0
end

call print "# AIL: a function starts a chunk, with the comment above it\n"
call filemkdir "lib" 493
call byadd f "# a.aiw -- two functions\nuse \"x.aiw\"\n\n# the first,\n# with two lines of comment\nfn one a\n\tret a\nend\n"
call byadd f "fn two a\n\t# a comment inside\n\tret a\nend\n\n\n# no function follows\nvar v\n# the third\n\nfn three\nend\ncall one 1\n"
call save "lib/a.aiw"
call filewrite "list.txt" "lib/a.aiw\n"
call run

call print "\n# Markdown: a heading starts a chunk, a line in a fence does not\n"
call byadd f "intro\n\n# Title\n\ntext \\ \"quoted\"\n```\n# a comment of AIL\nfn x\n```\n#no heading\n####### seven\n## Second\n   \n\t\nlast"
call save "doc.md"
call filewrite "list.txt" "doc.md\n"
call run

call print "\n# forty lines at most; blank lines at the ends belong to no chunk\n"
i=0
while i<95
	if (i==39)|(i==40)|(i==41)
		call byadd f "\n"
	else
		call byadd f "x\n"
	end
	i+=1
end
call save "long.aiw"
call filewrite "list.txt" "long.aiw\n"
call run

call print "\n# 1500 bytes at most, but for a line that is longer\n"
# three lines of 700 bytes, one of 1600, one of 100 and one of 1399
i=0
while i<6
	n=700
	if i==3
		n=1600
	end
	if i==4
		n=100
	end
	if i==5
		n=1399
	end
	while n>1
		call byaddb f 97+i
		n-=1
	end
	call byaddb f 10
	i+=1
end
call save "wide.md"
call filewrite "list.txt" "wide.md\n"
call run

call print "\n# files without a chunk, carriage returns, paths that are passed over\n"
call filewrite "empty.aiw" ""
call filewrite "blank.md" "\n \n\t\x0d\n"
call filewrite "crlf.aiw" "fn a\x0d\nend\x0d\n\x0d\nfn b\x0d\nend\x0d\n"
call filewrite "list.txt" "empty.aiw\nMakefile\nblank.md\n.aiw\n.md\nnone.txt\n\ncrlf.aiw\nlib/a.aiw"
call run

call print "\n# without -c: every text file, in the language the end of its path names\n"
call filemkdir "src" 493
call filemkdir "a.b" 493
call filewrite "src/m.py" "def f():\n    return 1\n\nx = f()\n"
call filewrite "notes.txt" "a note\n"
call filewrite "Makefile" "all:\n\techo\n"
call filewrite ".gitignore" "build\n"
call filewrite "a.b/c" "no end\n"
call filewrite "x." "an empty end\n"
call filewrite "UP.PY" "an end that is not in the table\n"
call filewrite "ff.c" "int a;\x0cint b;\n"
call filewrite "list.txt" "lib/a.aiw\ndoc.md\nsrc/m.py\nnotes.txt\nMakefile\n.gitignore\na.b/c\nx.\nUP.PY\nff.c\nempty.aiw\n"
call all 1

call print "\n# what is not text is passed over, with a line if its name says text\n"
call filewrite "bin.dat" "a\0b"
call filewrite "img.png" "\x89PNG\x0d\x0a\x1a\x0a"
call filewrite "bad.py" "x=\"\xa0\"\n"
call filewrite "del.txt" "a\x7fb\n"
call filewrite "esc.sh" "echo \x1b[0m\n"
call filewrite "cut.md" "caf\xc3"
call filewrite "list.txt" "bin.dat\nimg.png\nbad.py\ndel.txt\nesc.sh\ncut.md\n../lib/a.aiw\nli\x01b/a.aiw\n/etc/a.md\nnotes.txt\n"
call all 1

call print "\n# a line longer than 1500 bytes is cut where a character ends\n"
# 1499 bytes and a character of two, 1497 bytes and one of three, ten bytes
call byadd f "first\n"
i=0
while i<1499
	call byaddb f 97
	i+=1
end
call byadd f "\xc3\xa9"
i=0
while i<1497
	call byaddb f 98
	i+=1
end
call byadd f "\xe2\x82\xac"
call byadd f "cccccccccc\nlast\n"
call save "wide.txt"
call filewrite "list.txt" "wide.txt\nwide.md\n"
call all 1

call print "\n# 1048576 bytes are read, and a file of a byte more is passed over\n"
call byadd f "x\n"
i=2
while i<1048576
	call byaddb f 10
	i+=1
end
load f as q
load f+8 as m
call filewrite "most.txt" q m
call byaddb f 10
call save "more.txt"
call filewrite "list.txt" "most.txt\nmore.txt\n"
call all 0

call print "\n# PDF files: a chunk has the number of its page; pages and files that cannot be read\n"
