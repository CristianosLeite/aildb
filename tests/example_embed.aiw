# build/embed, the embeddings of the example, against a service that
# answers as Ollama does and says in each vector what text it got: the
# number of its bytes and their sum (tests/lib/embedfake.aiw). The texts
# of chunks, with their prefix, a text with bytes that are no UTF-8, each
# run of which is three bytes of U+FFFD for the model, and more texts
# than one request holds; queries, the field before the first tab of a
# line, an empty line passed over; what Ollama says of the model; and a
# model that refuses, a vector of three numbers, a line that is no
# string, a file that is not there and a service that is not there.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "lib/std/proc.aiw"
use "tests/lib/cmd.aiw"
buf b 24
buf line 24
buf ts 16
buf big 24
var port
# run embed with the arguments p n and show what it did
fn embed p n
	call bycut line 0
	call byadd line "/usr/bin/env OLLAMA_HOST=127.0.0.1:"
	call byaddn line port
	call byaddb line 32
	call byadd line cmdhome cmdhomen
	call byadd line "/build/embed "
	call byadd line p n
	load line as q
	load line+8 as m
	call cmdargs q m as av
	call cmdrun av -1 cmdso cmdse as st
	call print "$ embed "
	call print p n
	call print "\n"
	load cmdso as q
	load cmdso+8 as m
	call print q m
	load cmdse as q
	load cmdse+8 as m
	call print q m
	call print "status "
	call putn st
	call print "\n"
end
# print, for each vector of the file p n, its first two elements as
# whole numbers, and whether the 766 after them are the binary32 of 0.1
fn vectors p n
	call bycut b 0
	call fileread p n b as r
	load b as q
	load b+8 as m
	call putn m
	call print " bytes:"
	i=0
	while i+3072<=m
		load4 q+i as w
		f4to8 w as x
		ftoi x as a
		load4 q+i+4 as w
		f4to8 w as x
		ftoi x as s
		rest=1
		j=8
		while j<3072
			load4 q+i+j as w
			if w!=0x3dcccccd
				rest=0
			end
			j+=4
		end
		call print " ("
		call putn a
		call print " "
		call putn s
		call print " "
		call putn rest
		call print ")"
		i+=3072
	end
	call print "\n"
end
call cmdspawn "embed-fake port.txt" as fake
call cmdawait "port.txt" 5000 as r
store ts 0
store ts+8 20000000
sys nanosleep ts 0
call fileread "port.txt" b
load b as p
load b+8 as n
i=0
while i<n
	loadb p+i as c
	port=port*10+c-48
	i+=1
end

call print "# chunks: 17 bytes of prefix before each\n"
call filewrite "t.jsonl" "\"ab\"\n\"a\\tb\\u00e9\"\n\"\"\n"
call embed "document t.jsonl v.bin"
call vectors "v.bin"
call print "# bytes that are no UTF-8: a byte, the start of a character, a surrogate\n"
call filewrite "t.jsonl" "\"a\xffb\"\n\"\xe2\x82\"\n\"\xf0\x9f\x98x\"\n\"\xed\xa0\x80\"\n\"\xc3\xa9\"\n"
call embed "document t.jsonl v.bin"
call vectors "v.bin"
call print "# 35 chunks, more than two requests hold\n"
call bycut line 0
i=0
while i<35
	call byadd line "\"x\"\n"
	i+=1
end
load line as p
load line+8 as n
call filewrite "t.jsonl" p n
call embed "document t.jsonl v.bin"
call bycut b 0
call fileread "v.bin" b
load b+8 as n
call putn n/3072
call print " vectors in the file\n"
call print "# queries: 14 bytes of prefix, the field before a tab, no empty line\n"
call filewrite "q.tsv" "abc\tlib/a.aiw\t3\n\nde\n"
call embed "query q.tsv q.bin"
call vectors "q.bin"
call print "# the model\n"
call embed "model"
call print "# what cannot be done\n"
call filewrite "t.jsonl" "\"fine\"\n\"refuse this\"\n"
call embed "document t.jsonl bad.bin"
call filewrite "t.jsonl" "\"a short one\"\n"
call embed "document t.jsonl bad.bin"
call filewrite "t.jsonl" "no string\n"
call embed "document t.jsonl bad.bin"
call embed "document absent.jsonl bad.bin"
call embed "query q.tsv"
call embed "other q.tsv q.bin"
call fileopen "bad.bin" 0 0 as fd
call fileopen "bad.bin.part" 0 0 as fd2
call print "bad.bin or its part is there: "
call putn (fd!=-2)|(fd2!=-2)
call print "\n"
# No memory for the text: 3000 chunks of 4 KiB, 12 MiB, under a limit
# of 32 MiB for the process, which prlimit of util-linux sets. Nothing
# is embedded of a text that is not whole.
call bycut big 0
i=0
while i<3000
	j=0
	call byaddb big 34
	while j<4092
		call byaddb big 120
		j+=1
	end
	call byadd big "\"\n"
	i+=1
end
load big as p
load big+8 as n
call filewrite "big.jsonl" p n
call bycut line 0
call byadd line "/usr/bin/env OLLAMA_HOST=127.0.0.1:"
call byaddn line port
call byadd line " /usr/bin/prlimit --as=33554432 "
call byadd line cmdhome cmdhomen
call byadd line "/build/embed document big.jsonl bad.bin"
load line as q
load line+8 as m
call cmdargs q m as av
call cmdrun av -1 cmdso cmdse as st
call print "$ embed document big.jsonl bad.bin, with 32 MiB of memory\n"
load cmdso as q
load cmdso+8 as m
call print q m
load cmdse as q
load cmdse+8 as m
call print q m
call print "status "
call putn st
call print "\n"
call fileopen "bad.bin" 0 0 as fd
call fileopen "bad.bin.part" 0 0 as fd2
call print "bad.bin or its part is there: "
call putn (fd!=-2)|(fd2!=-2)
call print "\n"
call print "# the options: other prefixes, another dimension, another model\n"
call filewrite "t.jsonl" "\"ab\"\n"
call embed "-D X: -Q Y:Z: document t.jsonl v.bin"
call vectors "v.bin"
call filewrite "q.tsv" "abc\n"
call embed "-D X: -Q Y:Z: query q.tsv q.bin"
call vectors "q.bin"
# the fake answers a text with "short" in it with three numbers
call filewrite "t.jsonl" "\"a short one\"\n"
call embed "-d 3 document t.jsonl three.bin"
call bycut b 0
call fileread "three.bin" b
load b+8 as n
call putn n
call print " bytes\n"
call filewrite "t.jsonl" "\"ab\"\n"
call embed "-d 3 document t.jsonl bad.bin"
call embed "-m other model"
call embed "-m none model"
call embed "-d 0 document t.jsonl bad.bin"
call embed "-d 70000 document t.jsonl bad.bin"
call embed "-x 1 document t.jsonl bad.bin"
call embed "-m model"
sys kill fake 9
call procwait fake 0 as r
call filewrite "t.jsonl" "\"ab\"\n"
call embed "document t.jsonl bad.bin"
