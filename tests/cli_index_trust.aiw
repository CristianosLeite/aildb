# the command of a provider is run only if the user named it for the
# directory, with build/provider-fake as the provider, whose log shows
# what was asked. An index that was made with options is searched; a
# copy of the directory, with the configuration in it as a checkout
# that came with one would have it, is not: the search by text and
# aildb index without options end with status 2 and a line that names
# the command, and the provider is asked for nothing. The options given
# for the copy allow it. A command that was changed in the file by hand
# is not allowed, nor is the directory after it was moved. The commands
# that are allowed are lines of a file of the user, under
# XDG_CONFIG_HOME or under HOME, one for a directory and a command and
# no second one when the same is named again; without either variable
# nothing is allowed and nothing can be, which is said before the
# provider is asked. What is allowed is the program that the name of the
# command was at that moment: the configuration has its path from the
# root, so a search that is started in another directory and with
# another PATH, where the same name is another program, runs the one
# that was named; and a program that lies in the indexed directory is
# allowed with the bytes it had, and is not run when they are others.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "lib/std/proc.aiw"
use "tests/lib/cmd.aiw"
use "tests/lib/dir.aiw"
buf step 24
# run aildb with the line p n where it is to refuse: its status, what it
# printed, and what it said with FAKE for the path of the provider,
# which is not the same wherever the test runs
fn deny p n
	call print "$ aildb "
	call print p n
	call print "\n"
	call bycut step 0
	call byadd step "st=0\nXDG_CONFIG_HOME=\"$PWD/xdg\" GIT_CEILING_DIRECTORIES=\"$PWD\" \"$AILDB\" "
	call byadd step p n
	call byadd step " > deny.out 2> deny.err || st=$?\necho status $st\ncat deny.out\nsed \"s|$FAKE|FAKE|\" deny.err\n"
	load step as q
	load step+8 as m
	tail dirsh q m
end
call dirsh "mkdir p\nprintf 'alpha beta\\n' > p/a.txt\nprintf 'gamma\\n' > p/b.txt\n"
call print "# an index made with options: its command is allowed\n"
call dirrun "index p -i m1 -d 8 -- FAKE spread"
call dirrun "search p --text gamma -k 1"
call dirasked
call dirsh "ls xdg/aildb\nstat -c %a xdg/aildb/trusted\nwc -l < xdg/aildb/trusted\ncut -f2 xdg/aildb/trusted | sed \"s|^$PWD|TMP|\"\n"
call print "# a copy of the directory, its configuration with it: nothing is run\n"
call dirsh "cp -r p c\n"
call deny "search c --text gamma -k 1"
call deny "index c"
call dirsh "printf 'new\\n' > c/n.txt\n"
call deny "search c --text new -k 1"
call dirasked
call print "# the options given for it allow it\n"
call dirrun "index c -i m1 -d 8 -- FAKE spread"
call dirrun "search c --text new -k 1"
call dirasked
call dirsh "wc -l < xdg/aildb/trusted\n"
call print "# the same named again: no second line\n"
call dirrun "index c -i m1 -d 8 -- FAKE spread"
call dirsh "wc -l < xdg/aildb/trusted\n"
call print "# a command changed in the file by hand\n"
call dirsh "cp p/.aildb/config config.kept\nprintf 'arg\\tit'\"'\"'s more\\n' >> p/.aildb/config\n"
call deny "search p --text gamma -k 1"
call dirsh "sed -i 's|^arg\\t.*provider-fake$|arg\\t/bin/sh|' p/.aildb/config\ngrep -c /bin/sh p/.aildb/config\n"
call deny "search p --text gamma -k 1"
call dirsh "cp config.kept p/.aildb/config\n"
call dirrun "search p --text gamma -k 1"
call dirasked
call print "# the directory moved\n"
call dirsh "mv p moved\n"
call deny "search moved --text gamma -k 1"
call dirsh "mv moved p\n"
call dirrun "search p --text gamma -k 1"
call dirasked
call print "# no directory of the user: nothing is allowed, and nothing can be\n"
call dirsh "env -i \"$AILDB\" search p --text gamma -k 1 2>&1 | sed \"s|$FAKE|FAKE|\"\nenv -i HOME=home XDG_CONFIG_HOME=xdg \"$AILDB\" search p --text gamma -k 1 2>&1 | sed \"s|$FAKE|FAKE|\"\nmkdir n\nprintf 'text\\n' > n/t.txt\nenv -i \"$AILDB\" index n -i m1 -d 8 -- \"$FAKE\" 2>&1 || echo status $?\nls -A n\n"
call dirasked
call print "# HOME alone: the file is in .config of it\n"
call dirsh "mkdir home\nenv -i HOME=\"$PWD/home\" GIT_CEILING_DIRECTORIES=\"$PWD\" \"$AILDB\" index n -i m1 -d 8 -- \"$FAKE\"\nfind home | sort\nenv -i HOME=\"$PWD/home\" GIT_CEILING_DIRECTORIES=\"$PWD\" \"$AILDB\" search n --text text -k 1\nenv -i HOME=\"$PWD/home\" GIT_CEILING_DIRECTORIES=\"$PWD\" \"$AILDB\" search p --text gamma -k 1 2>&1 | sed \"s|$FAKE|FAKE|\"\n"
call dirasked
call print "# a program named by its name alone, then searched with another PATH and from another directory\n"
call dirsh "mkdir bin1 bin2 q\nprintf 'q text\\n' > q/t.txt\ncp \"$FAKE\" bin1/prov\nprintf '#!/bin/sh\\ntouch \"$RAN\"\\nexit 3\\n' > bin2/prov\nchmod +x bin2/prov\nexport RAN=\"$PWD/ran\" XDG_CONFIG_HOME=\"$PWD/xdg\" GIT_CEILING_DIRECTORIES=\"$PWD\"\nPATH=\"$PWD/bin1:$PATH\" \"$AILDB\" index q -i m1 -d 8 -- prov spread\ngrep '^arg' q/.aildb/config | sed \"s|$PWD|TMP|\"\ncd bin2\nPATH=\"$PWD:$PATH\" \"$AILDB\" search ../q --text 'q text' -k 1\ncd ..\nls ran 2>&1 | sed 's/^ls: .*: /ls: /'\n"
call print "# a program named from the directory it is in\n"
call dirsh "export RAN=\"$PWD/ran\" XDG_CONFIG_HOME=\"$PWD/xdg\" GIT_CEILING_DIRECTORIES=\"$PWD\"\ncd bin1\n\"$AILDB\" index ../q -i m1 -d 8 -- ./prov spread\ncd ../bin2\n\"$AILDB\" search ../q --text 'q text' -k 1\ncd ..\ngrep '^arg' q/.aildb/config | sed \"s|$PWD|TMP|\"\nls ran 2>&1 | sed 's/^ls: .*: /ls: /'\n"
call print "# a program of the indexed directory: allowed with the bytes it has\n"
call dirsh "export RAN=\"$PWD/ran\" XDG_CONFIG_HOME=\"$PWD/xdg\" GIT_CEILING_DIRECTORIES=\"$PWD\"\ncp \"$FAKE\" q/prov\n\"$AILDB\" index q -i m1 -d 8 -- q/prov spread > /dev/null 2> index.err || echo status $?\ncat index.err\n\"$AILDB\" search q --text 'q text' -k 1 2> search.err | wc -l\ncat search.err\nrm q/prov\ncp bin2/prov q/prov\nst=0\n\"$AILDB\" search q --text 'q text' -k 1 > search.out 2> search.err || st=$?\necho status $st\ncat search.out\nsed \"s|$PWD|TMP|g\" search.err\nls ran 2>&1 | sed 's/^ls: .*: /ls: /'\n"
call print "# a program that is not there\n"
call dirrun "index q -i m1 -d 8 -- /nonexistent/provider"
call dirrun "index q -i m1 -d 8 -- no-such-program-of-aildb"
