# tests/lib/cmd.aiw -- start a program for a test and show what it did.
# A test that uses it uses lib/std/io.aiw, lib/std/bytes.aiw,
# lib/std/file.aiw and lib/std/proc.aiw first, and runs under
# tests/run.sh, which starts it at the top of the repository and names a
# directory for its files in AILDB_TMP.
#
# The lines below run where the use stands: they note the directory the
# test was started in, where build/ is, and make the directory of
# AILDB_TMP the current one. A test therefore names the files it makes
# without a directory, and a program by its name alone: "aildb check x"
# starts build/aildb of the repository.
#
# Every name of this file starts with "cmd"; a test has no var of such a
# name (see lib/std/io.aiw).

const cmdgetcwd 79
const cmdchdir 80
buf cmdhome 4096        # the directory the test was started in
buf cmdexe 8192         # the path of the program of the last cmdargs
buf cmdtmp 4096         # AILDB_TMP with a NUL byte
buf cmdso 24            # what cmdshow read of the two outputs
buf cmdse 24
buf cmdline 4096        # the arguments of cmdargs, a NUL after each
buf cmdargv 520         # their addresses, 64 at most, and a 0
var cmdhomen

sys cmdgetcwd cmdhome 4096 as cmdr
ifsle cmdr 0
	call die "cmd: no current directory\n"
end
cmdhomen=cmdr-1
call procvar "AILDB_TMP" as cmdp cmdn
if (cmdp==0)|(cmdn>4095)
	call die "cmd: AILDB_TMP is not set\n"
end
call bycopy cmdtmp cmdp cmdn
sys cmdchdir cmdtmp as cmdr
if cmdr
	call die "cmd: cannot enter AILDB_TMP\n"
end

# Run the program whose arguments are at cmdav, as procstart takes them,
# until it ends: its result as procwait gives it, an exit status or a
# signal negated, or -2000 if the test could not start it or read what it
# wrote. cmdin is the descriptor it reads as stdin, -1 for /dev/null. Its
# stdout and stderr go to the files cmd.out and cmd.err and are,
# afterwards, the contents of the bytes buffers cmdout and cmderr.
fn cmdrun cmdav cmdin cmdout cmderr
	call fileopen "cmd.out" 0x241 420 as cmdo
	call fileopen "cmd.err" 0x241 420 as cmde
	cmdi=cmdin
	if cmdin==-1
		call fileopen "/dev/null" 0 0 as cmdi
	end
	# a descriptor that is an error has the sign bit, and so has the or
	ifslt cmdo|cmde|cmdi 0
		ret -2000
	end
	call procstart cmdav cmdi cmdo cmde as cmdpid
	sys close cmdo
	sys close cmde
	if cmdin==-1
		sys close cmdi
	end
	ifslt cmdpid 0
		ret -2000
	end
	call procwait cmdpid 0 as cmds
	call bycut cmdout 0
	call bycut cmderr 0
	call fileread "cmd.out" cmdout as cmdx
	call fileread "cmd.err" cmderr as cmdy
	ifslt cmdx|cmdy 0
		ret -2000
	end
	ret cmds
end

# The arguments of a command line, the cmdn bytes at cmdp, as procstart
# takes them: the address of their addresses. An argument ends at a
# space, so none has a space in it and none is empty; the line is shorter
# than 4096 bytes and has 64 arguments at most, or the result is 0. A
# first argument without a slash is a program of build/ in the
# repository, and is given by its whole path. The result is good until
# the next call.
fn cmdargs cmdp cmdn
	if cmdn>4095
		ret 0
	end
	cmdi=0
	cmdk=0
	cmdw=0
	while cmdi<cmdn
		loadb cmdp+cmdi as cmdc
		if cmdc==32
			storeb cmdline+cmdi 0
			cmdw=0
		else
			storeb cmdline+cmdi cmdc
			ifz cmdw
				if cmdk>=64
					ret 0
				end
				store cmdargv+cmdk*8 cmdline+cmdi
				cmdk+=1
				cmdw=1
			end
		end
		cmdi+=1
	end
	storeb cmdline+cmdn 0
	store cmdargv+cmdk*8 0
	ifz cmdk
		ret 0
	end
	load cmdargv as cmdq
	cmdi=0
	label slash
	loadb cmdq+cmdi as cmdc
	if cmdc
		if cmdc==47
			ret cmdargv
		end
		cmdi+=1
		jmp slash
	end
	call bycopy cmdexe cmdhome cmdhomen
	call bycopy cmdexe+cmdhomen "/build/"
	call bycopy cmdexe+cmdhomen+7 cmdq cmdi+1
	store cmdargv cmdexe
	ret cmdargv
end

# Run a command line with /dev/null as its stdin and print the line, what
# the program wrote to stdout and to stderr, and how it ended; the result
# is that of cmdrun.
fn cmdshow cmdp cmdn
	call print "$ "
	call print cmdp cmdn
	call print "\n"
	cmds=-2000
	call cmdargs cmdp cmdn as cmdav
	if cmdav
		call cmdrun cmdav -1 cmdso cmdse as cmds
	end
	call print "--- stdout\n"
	load cmdso as cmdq
	load cmdso+8 as cmdl
	call print cmdq cmdl
	call print "--- stderr\n"
	load cmdse as cmdq
	load cmdse+8 as cmdl
	call print cmdq cmdl
	ifslt cmds 0
		call print "--- signal "
		call putn 0-cmds
	else
		call print "--- status "
		call putn cmds
	end
	call print "\n"
	ret cmds
end
