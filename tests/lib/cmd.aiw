# tests/lib/cmd.aiw -- start a program for a test and show what it did.
# A test that uses it uses lib/std/io.aiw, lib/std/bytes.aiw,
# lib/std/file.aiw and lib/std/proc.aiw first, and runs under "ail
# test", which starts it at the top of the package and names a directory
# for its files in AIL_TMP.
#
# The lines below run where the use stands: they note the directory the
# test was started in, where build/ is, and make the directory of
# AIL_TMP the current one. A test therefore names the files it makes
# without a directory, and a program by its name alone: "aildb check x"
# starts build/aildb of the repository.
#
# cmdshow takes a command as one line, whose arguments end at a space;
# cmdbegin, cmdadd and cmdshowv take one whose arguments have spaces.
#
# Every name of this file starts with "cmd"; a test has no var of such a
# name (see lib/std/io.aiw).

const cmdgetcwd 79
const cmdchdir 80
buf cmdhome 4096        # the directory the test was started in
buf cmdexe 8192         # the path of the program of the last cmdargs
buf cmdtmp 4096         # AIL_TMP with a NUL byte
buf cmdso 24            # what cmdshow read of the two outputs
buf cmdse 24
buf cmdline 4096        # the arguments of cmdargs, a NUL after each
buf cmdargv 520         # their addresses, 64 at most, and a 0
buf cmdnames 24         # the names of cmdstaged
var cmdhomen cmdused cmdcount

sys cmdgetcwd cmdhome 4096 as cmdr
ifsle cmdr 0
	call die "cmd: no current directory\n"
end
cmdhomen=cmdr-1
call procvar "AIL_TMP" as cmdp cmdn
if (cmdp==0)|(cmdn>4095)
	call die "cmd: AIL_TMP is not set\n"
end
call bycopy cmdtmp cmdp cmdn
sys cmdchdir cmdtmp as cmdr
if cmdr
	call die "cmd: cannot enter AIL_TMP\n"
end

# Run the program whose arguments are at cmdav, as procstart takes them,
# until it ends: its result as procwait gives it, an exit status or a
# signal negated, or -2000 if the test could not start it or read what it
# wrote. cmdin is the descriptor it reads as stdin, -1 for /dev/null. Its
# stdout and stderr go to the files cmd.out and cmd.err and are,
# afterwards, the contents of the bytes buffers cmdout and cmderr.
fn cmdrun cmdav cmdin cmdout cmderr
	call fileopen "cmd.out" 0x241 420 as cmdo
	call fileopen "cmd.err" 0x241 420 as cmde
	cmdi=cmdin
	if cmdin==-1
		call fileopen "/dev/null" 0 0 as cmdi
	end
	# a descriptor that is an error has the sign bit, and so has the or
	ifslt cmdo|cmde|cmdi 0
		ret -2000
	end
	call procstart cmdav cmdi cmdo cmde as cmdpid
	sys close cmdo
	sys close cmde
	if cmdin==-1
		sys close cmdi
	end
	ifslt cmdpid 0
		ret -2000
	end
	call procwait cmdpid 0 as cmds
	call bycut cmdout 0
	call bycut cmderr 0
	call fileread "cmd.out" cmdout as cmdx
	call fileread "cmd.err" cmderr as cmdy
	ifslt cmdx|cmdy 0
		ret -2000
	end
	ret cmds
end

# The arguments of a command line, the cmdn bytes at cmdp, as procstart
# takes them: the address of their addresses. An argument ends at a
# space, so none has a space in it and none is empty; the line is shorter
# than 4096 bytes and has 64 arguments at most, or the result is 0. A
# first argument without a slash is a program of build/ in the
# repository, and is given by its whole path. The result is good until
# the next call.
fn cmdargs cmdp cmdn
	if cmdn>4095
		ret 0
	end
	cmdi=0
	cmdk=0
	cmdw=0
	while cmdi<cmdn
		loadb cmdp+cmdi as cmdc
		if cmdc==32
			storeb cmdline+cmdi 0
			cmdw=0
		else
			storeb cmdline+cmdi cmdc
			ifz cmdw
				if cmdk>=64
					ret 0
				end
				store cmdargv+cmdk*8 cmdline+cmdi
				cmdk+=1
				cmdw=1
			end
		end
		cmdi+=1
	end
	storeb cmdline+cmdn 0
	store cmdargv+cmdk*8 0
	ifz cmdk
		ret 0
	end
	tail cmdprog
end

# The arguments at cmdargv with the program found: a first argument
# without a slash is a program of build/ in the repository, and is given
# by its whole path. The result is cmdargv, or 0 if there is no argument.
fn cmdprog
	load cmdargv as cmdq
	ifz cmdq
		ret 0
	end
	cmdi=0
	label slash
	loadb cmdq+cmdi as cmdc
	if cmdc
		if cmdc==47
			ret cmdargv
		end
		cmdi+=1
		jmp slash
	end
	call bycopy cmdexe cmdhome cmdhomen
	call bycopy cmdexe+cmdhomen "/build/"
	call bycopy cmdexe+cmdhomen+7 cmdq cmdi+1
	store cmdargv cmdexe
	ret cmdargv
end

# Start the arguments of a command that cmdshowv is to run: none yet.
fn cmdbegin
	cmdused=0
	cmdcount=0
	store cmdargv 0
end

# Add the argument of the cmdn bytes at cmdp to them, which may have
# spaces and may be empty, but has no NUL byte: 1, or 0 if there are 64
# already or the arguments would be more than 4095 bytes.
fn cmdadd cmdp cmdn
	if (cmdcount>=64)|(cmdused+cmdn>4094)
		ret 0
	end
	call bycopy cmdline+cmdused cmdp cmdn
	storeb cmdline+cmdused+cmdn 0
	store cmdargv+cmdcount*8 cmdline+cmdused
	cmdcount+=1
	store cmdargv+cmdcount*8 0
	cmdused+=cmdn+1
	ret 1
end

# Run the arguments of cmdbegin and cmdadd as cmdshow runs a line, and
# print the same; an argument that is empty or has a space is printed
# between two "'". The first one is a program as cmdargs finds it.
fn cmdshowv
	call print "$"
	cmdk=0
	label each
	load cmdargv+cmdk*8 as cmdq
	if cmdq
		call print " "
		call strlen cmdq as cmdl
		cmdw=cmdl
		cmdi=0
		while cmdi<cmdl
			loadb cmdq+cmdi as cmdc
			if cmdc==32
				cmdw=0
			end
			cmdi+=1
		end
		if cmdw
			call print cmdq cmdl
		else
			call print "'"
			call print cmdq cmdl
			call print "'"
		end
		cmdk+=1
		jmp each
	end
	call print "\n"
	cmds=-2000
	call cmdprog as cmdav
	if cmdav
		call cmdrun cmdav -1 cmdso cmdse as cmds
	end
	tail cmdtold cmds
end

# Run a command line with /dev/null as its stdin and print the line, what
# the program wrote to stdout and to stderr, and how it ended; the result
# is that of cmdrun.
fn cmdshow cmdp cmdn
	tail cmdshowin cmdp cmdn ""
end

# The same with the file at the path of the cmdm bytes at cmdq as its
# stdin, which the line printed says with a "<"; without a path, or with
# one that cannot be opened, the stdin is /dev/null.
fn cmdshowin cmdp cmdn cmdq cmdm
	call print "$ "
	call print cmdp cmdn
	cmdin=-1
	if cmdm
		call print " < "
		call print cmdq cmdm
		call fileopen cmdq cmdm 0 0 as cmdin
		ifslt cmdin 0
			cmdin=-1
		end
	end
	call print "\n"
	cmds=-2000
	call cmdargs cmdp cmdn as cmdav
	if cmdav
		call cmdrun cmdav cmdin cmdso cmdse as cmds
	end
	if cmdin!=-1
		sys close cmdin
	end
	tail cmdtold cmds
end

# print what the program of the last cmdrun wrote to stdout and to stderr
# and how it ended, which is cmds, the result
fn cmdtold cmds
	call print "--- stdout\n"
	load cmdso as cmdq
	load cmdso+8 as cmdl
	call print cmdq cmdl
	call print "--- stderr\n"
	load cmdse as cmdq
	load cmdse+8 as cmdl
	call print cmdq cmdl
	ifslt cmds 0
		call print "--- signal "
		call putn 0-cmds
	else
		call print "--- status "
		call putn cmds
	end
	call print "\n"
	ret cmds
end

# Start a command line and do not wait for it: the number of the child,
# for procwait, or a negative number. Its stdin is /dev/null, and its
# stdout and stderr go to the files bg.out and bg.err.
fn cmdspawn cmdp cmdn
	call cmdargs cmdp cmdn as cmdav
	ifz cmdav
		ret -2000
	end
	call fileopen "bg.out" 0x241 420 as cmdo
	call fileopen "bg.err" 0x241 420 as cmde
	call fileopen "/dev/null" 0 0 as cmdi
	ifslt cmdo|cmde|cmdi 0
		ret -2000
	end
	call procstart cmdav cmdi cmdo cmde as cmdpid
	sys close cmdo
	sys close cmde
	sys close cmdi
	ret cmdpid
end

# wait until there is a file at the path of the cmdn bytes at cmdp, for
# cmdms milliseconds at most: 1 if there is one, 0 if the time ran out
fn cmdawait cmdp cmdn cmdms
	local cmdts 16
	label look
	call fileopen cmdp cmdn 0 0 as cmdfd
	ifsge cmdfd 0
		sys close cmdfd
		ret 1
	end
	ifz cmdms
		ret 0
	end
	store cmdts 0
	store cmdts+8 1000000
	sys nanosleep cmdts 0
	cmdms-=1
	jmp look
end

# Start a command line with the descriptor cmdin as its stdin and do not
# wait for it: the number of the child, or a negative number. Its stdout
# goes to the file at the path of the cmdm bytes at cmdq, and what it
# writes to stderr is added to the file bg.err.
fn cmdspawnin cmdp cmdn cmdin cmdq cmdm
	call cmdargs cmdp cmdn as cmdav
	ifz cmdav
		ret -2000
	end
	call fileopen cmdq cmdm 0x241 420 as cmdo
	call fileopen "bg.err" 0x441 420 as cmde
	ifslt cmdo|cmde 0
		ret -2000
	end
	call procstart cmdav cmdin cmdo cmde as cmdpid
	sys close cmdo
	sys close cmde
	ret cmdpid
end

# The number of temporary files of build in the current directory: the
# names that end in a dot, sixteen hexadecimal digits and ".tmp", which
# is what docs/usage.md says a build names its file. -1 if the directory
# cannot be read.
fn cmdstaged
	call bycut cmdnames 0
	call filenames "." cmdnames as cmdk
	ifslt cmdk 0
		ret -1
	end
	load cmdnames as cmdq
	cmdc=0
	while cmdk
		call strlen cmdq as cmdl
		if cmdl>=21
			cmdw=cmdq+cmdl-21
			loadb cmdw as cmdx
			load4 cmdw+17 as cmdy
			# ".tmp" as the four bytes are read
			if (cmdx==46)&(cmdy==0x706d742e)
				cmdi=1
				while cmdi<17
					loadb cmdw+cmdi as cmdx
					if (cmdx-48>9)&(cmdx-97>5)
						jmp next
					end
					cmdi+=1
				end
				cmdc+=1
			end
		end
		label next
		cmdq+=cmdl+1
		cmdk-=1
	end
	ret cmdc
end
