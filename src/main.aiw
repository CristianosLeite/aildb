# src/main.aiw -- the commands of aildb. This is the one file that
# prints and exits; the functions of src/lib/ return what they found.
# docs/usage.md is the interface, and the exit statuses, one for each
# class of error, are the constants below.
#
# It is compiled into an executable by a file that uses lib/std/io.aiw
# and a file of hooks first: src/aildb.aiw for the one that is shipped.
#
# The commands are build, search and check, and index and the search
# of a directory by text, which are src/index.aiw.
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "src/lib/crc.aiw"
use "src/lib/text.aiw"
use "src/lib/fmt.aiw"
use "src/lib/snap.aiw"
use "src/lib/meta.aiw"
use "src/lib/norm.aiw"
use "src/lib/pack.aiw"
use "src/lib/topk.aiw"
use "src/lib/search.aiw"

const stusage 2         # wrong usage
const stinvalid 3       # an invalid snapshot or invalid input
const stio 4            # an I/O failure
const stbusy 5          # another build in progress for the destination
const stunsure 6        # published, durability not confirmed
const stprovider 7      # the embedding provider failed

buf msg 24              # the line that is being put together
buf snap 104            # the snapshot of the command
buf optv 416            # for each letter, the address and length of its value
buf text 24             # build: the metadata as it was read
buf recs 24             # its records
buf strs 24             # the strings of the snapshot
buf block 24            # everything before the vectors
buf tmp 24              # the path of the temporary file, with a NUL byte
var made                # 1 once this build has created that file
buf dst 24              # the path of the destination, with a NUL byte
buf lck 24              # the path of the lock file, with a NUL byte
var qvec                # search: the doubles of the query, normalized
buf sel 24              # the best records so far
const pwrite 18
const flock 73
const getrandom 318
buf sigact 32           # how a signal is to be taken: ignored
# the command index, which names the constants and the buffers above
use "src/index.aiw"

# print the usage on stderr and end the program
fn usage
	call eprint "usage: aildb build -o INDEX -v VECTORS -m METADATA -d DIMENSION -i MODEL [-r REVISION]
       aildb search INDEX -k LIMIT [-q QUERY] [-p PREFIX] [-l LANGUAGE] [-i MODEL]
       aildb search [DIRECTORY] --text QUERY -k LIMIT [-p PREFIX] [-l LANGUAGE] [-w MILLISECONDS]
       aildb check INDEX
       aildb index [DIRECTORY] [-i MODEL -d DIMENSION [-n PROVIDER] [-r REVISION] [-s NAME=VALUE]... [-t MILLISECONDS] [-b TEXTS] -- COMMAND [ARGUMENT...]]
"
	sys exit_group stusage
end

# end the program with the status st after the line of msg on stderr,
# which is the line itself if there was no memory to put it together
fn fail st
	call byaddb msg 10
	load msg as p
	load msg+8 as n
	call eprint p n
	sys exit_group st
end

# start the line of an error about the file at the path p n, which
# ixshow of src/index.aiw writes as the user knows it
fn about p n
	call bycut msg 0
	call byadd msg "aildb: "
	call ixshow p n
	call byadd msg ": "
end

# add to msg the words for the error e of the kernel, a negative number
fn oserr e
	e=0-e
	if e==2
		tail byadd msg "no such file or directory"
	end
	if e==5
		tail byadd msg "input/output error"
	end
	if e==12
		tail byadd msg "out of memory"
	end
	if e==13
		tail byadd msg "permission denied"
	end
	if e==19
		tail byadd msg "not a file that can be mapped"
	end
	if e==20
		tail byadd msg "not a directory"
	end
	if e==21
		tail byadd msg "is a directory"
	end
	if e==27
		tail byadd msg "file too large"
	end
	if e==28
		tail byadd msg "no space left on device"
	end
	if e==36
		tail byadd msg "path too long"
	end
	call byadd msg "error "
	tail byaddn msg e
end

# end the program for the result r of snapopen or snapcheck on the path
# p n, which is not 0: an error of the kernel or an invalid snapshot
fn badsnap p n r
	call about p n
	ifslt r 0
		call byadd msg "cannot open: "
		call oserr r
		call fail stio
	end
	call snapwhy msg snap r
	call fail stinvalid
end

# print the line of msg on stdout, or end the program if it cannot be
# written
fn say
	load msg as p
	load msg+8 as n
	call print p n as ok
	ifz ok
		call bycut msg 0
		call byadd msg "aildb: cannot write the output"
		call fail stio
	end
end

# make msg the line about the open snapshot: its records, its dimension,
# its model identifier and its source revision
fn summary
	call bycut msg 0
	call byadd msg "{\"records\":"
	load snap+16 as x
	call byaddn msg x
	call byadd msg ",\"dimension\":"
	load snap+24 as x
	call byaddn msg x
	call byadd msg ",\"model\":"
	load snap+64 as p
	load snap+72 as n
	call fmtjson msg p n
	call byadd msg ",\"source_revision\":"
	load snap+80 as p
	load snap+88 as n
	if n
		call fmtjson msg p n
	else
		call byadd msg "null"
	end
	call byadd msg "}\n"
end

# Read the options of a command from the argument first on: each a "-"
# with one of the letters of the an bytes at ap, then its value. An
# argument that is no such option, a letter twice and a value that is
# missing are wrong usage.
fn options first ap an
	i=0
	while i<416
		store optv+i 0
		i+=8
	end
	call argc as c
	i=first
	while i<c
		call argv i as p n
		if n!=2
			call usage
		end
		loadb p as x
		loadb p+1 as y
		call textfind ap an y as k ok
		if (x!=45)|(ok==0)|(i+1>=c)
			call usage
		end
		load optv+(y-97)*16 as x
		if x
			call usage
		end
		call argv i+1 as p n
		store optv+(y-97)*16 p
		store optv+(y-97)*16+8 n
		i+=2
	end
end

# the value of the option with the letter x: its address and length, or
# 0 and 0 if it was not given
fn opt x
	load optv+(x-97)*16 as p
	load optv+(x-97)*16+8 as n
	ret p n
end

# write the n bytes at p to the file fd, in as many writes as it takes:
# 0, or the error of the kernel
fn writeall fd p n
	while n
		sys write fd p n as r
		ifz r
			r=-5
		end
		ifslt r 0
			if r!=-4
				ret r
			end
			r=0
		end
		p+=r
		n-=r
	end
	ret 0
end

# the same at the offset o of the file, wherever its position is
fn writeat fd p n o
	while n
		sys pwrite fd p n o as r
		ifz r
			r=-5
		end
		ifslt r 0
			if r!=-4
				ret r
			end
			r=0
		end
		p+=r
		n-=r
		o+=r
	end
	ret 0
end

# map the file at the path p n to read it: its address, its size and 0,
# or the error of the kernel as the third result. A file of no bytes has
# the address 0.
fn mapfile p n
	local st 144
	# O_NONBLOCK, as the reader of a snapshot opens: a named pipe that
	# has no writer is not waited for
	call fileopen p n 0x800 0 as fd
	ifslt fd 0
		ret 0 0 fd
	end
	sys fstat fd st as r
	ifslt r 0
		sys close fd
		ret 0 0 r
	end
	# a regular file only, as the reader of a snapshot has it
	load4 st+24 as z
	z=z&0xf000
	if z!=0x8000
		sys close fd
		if z==0x4000
			ret 0 0 -21
		end
		ret 0 0 -19
	end
	load st+48 as z
	a=0
	if z
		sys mmap 0 z 1 2 fd 0 as a
		if a>-4096
			sys close fd
			ret 0 0 a
		end
	end
	sys close fd
	ret a z 0
end

# end the program with the status st after the line of msg, and remove
# the temporary file of build first, if this build made one: no other
# file is removed, whatever its name
fn giveup st
	if made
		load tmp as p
		load tmp+8 as n
		call fileunlink p n-1
	end
	call fail st
end

# end the program for the error r of the kernel in doing what the wn
# bytes at wp say with the temporary file. The line names the
# destination: the name of the temporary file is another in every build.
fn tmperr wp wn r
	load dst as p
	load dst+8 as n
	call about p n-1
	call byadd msg wp wn
	call oserr r
	call giveup stio
end

# Make the temporary file of build beside the destination and open it
# to write: its descriptor. Its name is that of the destination, a dot,
# sixteen hexadecimal digits from the random numbers of the kernel and
# ".tmp", and it is created only if nothing has that name (O_EXCL), so
# no file that was there is opened, cut or removed, a snapshot whose
# name ends in ".tmp" least of all.
fn stage
	local rnd 8
	load dst as dp
	load dst+8 as dn
	dn-=1
	tries=0
	label again
	sys getrandom rnd 8 0 as r
	if r!=8
		call about dp dn
		call byadd msg "cannot name the temporary file: "
		call oserr r
		call fail stio
	end
	load rnd as x
	call bycut tmp 0
	call byadd tmp dp dn as a
	call byaddb tmp 46 as b
	call fmthex tmp x as c
	call byadd tmp ".tmp\0" as d
	ifz a&b&c&d
		call bycut msg 0
		call byadd msg "aildb: out of memory"
		call fail stio
	end
	load tmp as tp
	load tmp+8 as tn
	# O_WRONLY, O_CREAT and O_EXCL
	call fileopen tp tn-1 0xc1 420 as fd
	if (fd==-17)&(tries<16)
		tries+=1
		jmp again
	end
	ifslt fd 0
		call about dp dn
		call byadd msg "cannot create the temporary file: "
		call oserr fd
		call fail stio
	end
	made=1
	ret fd
end

# flush the directory of the file at the path p n to its device: 0, or
# the error of the kernel
fn syncdir p n
	i=n
	while i
		loadb p+i-1 as c
		jeq c 47 cut
		i-=1
	end
	label cut
	# no slash: this directory; a slash at the start alone: the root
	if i>1
		call fileopen p i-1 0x10000 0 as fd
	else
		if i
			call fileopen "/" 0x10000 0 as fd
		else
			call fileopen "." 0x10000 0 as fd
		end
	end
	ifslt fd 0
		ret fd
	end
	call hooksync fd 2 as r
	sys close fd
	ret r
end

# Take the lock of a build for the destination, an exclusive flock on
# the file of the path in lck, which is made if it is not there and
# never removed; it is held until the program ends. If another build
# holds it the program ends here with the status of that.
fn lock
	load lck as p
	load lck+8 as n
	n-=1
	call fileopen p n 0x41 420 as fd
	ifslt fd 0
		call about p n
		call byadd msg "cannot create: "
		call oserr fd
		call fail stio
	end
	# LOCK_EX and LOCK_NB
	sys flock fd 6 as r
	if r==-11
		load dst as p
		load dst+8 as n
		call about p n-1
		call byadd msg "another build is in progress"
		call fail stbusy
	end
	if r
		call about p n
		call byadd msg "cannot lock: "
		call oserr r
		call fail stio
	end
end

# Write the snapshot of build to a temporary file, flush it, validate
# it, put it in the place of the destination and flush the directory.
# block is everything before the vectors, vec the address of the count
# vectors of dim binary32 as they were given, and vp vn the path they
# came from, for the line of an error. Returns when the destination is
# the new snapshot, which snap then is, and its directory was flushed;
# the lock is held by the caller.
fn publish vec count dim vp vn
	call stage as fd
	load tmp as tp
	load tmp+8 as tn
	tn-=1
	load block as bp
	load block+8 as bn
	call writeall fd bp bn as r
	if r
		call tmperr "cannot write the temporary file: " r
	end
	call hookstop 1
	# the doubles of one vector, and a megabyte or so of whole vectors as
	# they go to the file
	per=1048576/(dim*4)
	ifz per
		per=1
	end
	room=per*dim*4
	alloc dim*8 as q
	alloc room as w
	if (q==0)|(w==0)
		call tmperr "cannot write the temporary file: " -12
	end
	crc=0
	fill=0
	i=0
	while i<count
		call normwide vec+i*dim*4 q dim as r
		if r
			call about vp vn
			call byadd msg "the vector of line "
			call byaddn msg i+1
			if r==normnan
				call byadd msg " has an element that is not finite"
			else
				call byadd msg " is all zeros"
			end
			call giveup stinvalid
		end
		call normround q w+fill dim
		fill+=dim*4
		if fill==room
			call crc32 crc w fill as crc
			call writeall fd w fill as r
			if r
				call tmperr "cannot write the temporary file: " r
			end
			fill=0
		end
		i+=1
	end
	call crc32 crc w fill as crc
	call writeall fd w fill as r
	if r
		call tmperr "cannot write the temporary file: " r
	end
	# the checksums are known now: the header once more
	call packseal block crc
	call writeat fd bp 128 0 as r
	if r
		call tmperr "cannot write the temporary file: " r
	end
	# on the device before it is looked at and before it gets its name
	call hooksync fd 1 as r
	if r
		sys close fd
		call tmperr "cannot sync the temporary file: " r
	end
	sys close fd as r
	if r
		call tmperr "cannot write the temporary file: " r
	end
	# what was written must be a snapshot to the reader
	load dst as dp
	load dst+8 as dn
	call snapopen snap tp tn as r
	ifz r
		call snapcheck snap as r
	end
	ifslt r 0
		call tmperr "cannot read the temporary file back: " r
	end
	if r
		call about dp dn-1
		call byadd msg "written, and read back as no valid snapshot: "
		call snapwhy msg snap r
		call giveup stio
	end
	# what an index of a directory writes before its snapshot has its name
	call ixbefore
	call hookstop 2
	sys rename tp dp as r
	if r
		call tmperr "cannot rename the temporary file to it: " r
	end
	call hookstop 3
	# the new name is durable when its directory is: until then a loss of
	# power may bring the old snapshot back
	call syncdir dp dn-1 as r
	if r
		call about dp dn-1
		call byadd msg "published, but its directory could not be synced, so it may not survive a loss of power: "
		call oserr r
		call fail stunsure
	end
end

# aildb build -o INDEX -v VECTORS -m METADATA -d DIMENSION -i MODEL [-r REVISION]
fn build
	call options 2 "ovmdir"
	call opt 111 as op on
	call opt 118 as vp vn
	call opt 109 as mp mn
	call opt 100 as dp dn
	call opt 105 as ip in
	call opt 114 as rp rn
	if (op==0)|(vp==0)|(mp==0)|(dp==0)|(ip==0)
		call usage
	end
	call textnum dp dn as dim ok
	if (ok==0)|(dim-1>65535)
		call usage
	end
	call byadd dst op on as a
	call byaddb dst 0 as b
	call byadd lck op on as e
	call byadd lck ".lock\0" as f
	call bycut msg 0
	ifz a&b&e&f
		call byadd msg "aildb: out of memory"
		call fail stio
	end
	# the lock of a destination is the file of its name and ".lock", so a
	# snapshot of such a name could take the place of a lock that is held
	if on>=5
		call texteq op+on-5 5 ".lock" as ok
		if ok
			call about op on
			call byadd msg "a destination cannot have a name that ends in .lock, which is that of a lock file"
			call fail stinvalid
		end
	end
	call lock
	call bycut msg 0
	call textvalid ip in as ok
	if (in-1>254)|(ok==0)
		call byadd msg "aildb: the model identifier is empty, longer than 255 bytes or not valid text"
		call fail stinvalid
	end
	call byadd strs ip in
	ro=0
	if rp
		call textvalid rp rn as ok
		if (rn-1>254)|(ok==0)
			call byadd msg "aildb: the source revision is empty, longer than 255 bytes or not valid text"
			call fail stinvalid
		end
		ro=in
		call byadd strs rp rn
	end
	call fileread mp mn text as r
	ifslt r 0
		call about mp mn
		call byadd msg "cannot read: "
		call oserr r
		call fail stio
	end
	load text as p
	load text+8 as n
	call metaparse p n recs strs as count why
	if why
		call about mp mn
		call byadd msg "line "
		call byaddn msg count
		call byadd msg ": "
		call metawhy msg why
		if why==metamem
			call fail stio
		end
		call fail stinvalid
	end
	call mapfile vp vn as vec size r
	ifslt r 0
		call about vp vn
		call byadd msg "cannot read: "
		call oserr r
		call fail stio
	end
	if size!=count*dim*4
		call about vp vn
		call byadd msg "holds "
		call byaddn msg size
		call byadd msg " bytes, and "
		call byaddn msg count
		call byadd msg " records of "
		call byaddn msg dim
		call byadd msg " dimensions are "
		call byaddn msg count*dim*4
		call fail stinvalid
	end
	call packmeta block dim recs strs 0 in ro rn as ok
	ifz ok
		call byadd msg "aildb: out of memory"
		call fail stio
	end
	call publish vec count dim vp vn
	# the report of a durable snapshot; if it cannot be written the
	# snapshot is published all the same, and the line says so
	call summary
	load msg as p
	load msg+8 as n
	call print p n as ok
	ifz ok
		call about op on
		call byadd msg "published and synced, but the line about it could not be written to the output"
		call fail stio
	end
	sys exit_group 0
end

# read from the file fd to the n bytes at p until they are full or the
# file ends: the number of bytes read, or the error of the kernel
fn readupto fd p n
	got=0
	while got<n
		sys read fd p+got n-got as r
		ifz r
			ret got
		end
		ifslt r 0
			if r!=-4
				ret r
			end
			r=0
		end
		got+=r
	end
	ret got
end

# search: open the snapshot at the path ip in, read the query from the
# file at qp qn, or from stdin if qp is 0, and make qvec its doubles of
# the norm 1. mp mn is the model identifier the caller gave, if mp is
# not 0. Whatever is wrong ends the program. The dimension says how long
# a query is before a byte of it is read, so the bytes of a query and
# one more are all that is ever read: an input that is longer is known
# to be wrong by that byte, however long it is.
fn query ip in qp qn mp mn
	call snapopen snap ip in as r
	if r
		call badsnap ip in r
	end
	load snap+24 as dim
	load snap+64 as sp
	load snap+72 as sn
	if mp
		call texteq mp mn sp sn as ok
		ifz ok
			call about ip in
			call byadd msg "the model identifier of the snapshot is "
			call fmtjson msg sp sn
			call byadd msg ", not "
			call fmtjson msg mp mn
			call fail stinvalid
		end
	end
	need=dim*4
	alloc need+1 as p
	alloc dim*8 as q
	if (p==0)|(q==0)
		call bycut msg 0
		call byadd msg "aildb: out of memory"
		call fail stio
	end
	fd=0
	if qp
		call fileopen qp qn 0 0 as fd
	else
		set "standard input" as qp
		qn=14
	end
	r=fd
	ifsge fd 0
		call readupto fd p need+1 as r
	end
	ifslt r 0
		call about qp qn
		call byadd msg "cannot read: "
		call oserr r
		call fail stio
	end
	if r!=need
		call about qp qn
		call byadd msg "holds "
		if r>need
			call byadd msg "more than "
			r=need
		end
		call byaddn msg r
		call byadd msg " bytes, and a query of "
		call byaddn msg dim
		call byadd msg " dimensions is "
		call byaddn msg need
		call fail stinvalid
	end
	call searchquery snap p q as r
	if r
		call about qp qn
		if r==normnan
			call byadd msg "the query has an element that is not finite"
		else
			call byadd msg "the query is all zeros"
		end
		call fail stinvalid
	end
	qvec=q
end

# search: score every record of the snapshot that passes the filters
# against qvec and keep the best k in sel, in order, as searchrun of
# src/lib/search.aiw does it. pp pn is the prefix a path must start
# with, if pp is not 0, and lp ln the language a record must have, if
# lp is not 0. A score that is not finite ends the program before a
# result is printed: the query is finite, so the vector has an element
# that is not, which check would have found; ip in is the path for that
# line.
fn scan k pp pn lp ln ip in
	call searchrun snap sel qvec k pp pn lp ln as r i
	if r==searchnomem
		call bycut msg 0
		call byadd msg "aildb: out of memory"
		call fail stio
	end
	if r
		store snap+96 i
		call badsnap ip in snapvalue
	end
end

# search: print the line about the snapshot and a line for each record
# of sel, 60000 bytes or so at a time
fn results
	call bycut msg 0
	# the longest line is below 9000 bytes, so nothing is added to a
	# buffer that cannot take it
	call byneed msg 72000 as ok
	ifz ok
		call byadd msg "aildb: out of memory"
		call fail stio
	end
	call byadd msg "{\"source_revision\":"
	load snap+80 as p
	load snap+88 as n
	if n
		call fmtjson msg p n
	else
		call byadd msg "null"
	end
	call byadd msg ",\"model\":"
	load snap+64 as p
	load snap+72 as n
	call fmtjson msg p n
	call byadd msg "}\n"
	call searchcount sel as count
	i=0
	while i<count
		call searchhit snap sel i as s p n first last ok
		call byadd msg "{\"rank\":"
		call byaddn msg i+1
		call byadd msg ",\"score\":"
		call fmtfix msg s 6
		call byadd msg ",\"score_bits\":\""
		call fmthex msg s
		call byadd msg "\",\"path\":"
		call fmtjson msg p n
		call byadd msg ",\"start_line\":"
		call byaddn msg first
		call byadd msg ",\"end_line\":"
		call byaddn msg last
		call byadd msg "}\n"
		load msg+8 as n
		if n>60000
			call say
			call bycut msg 0
		end
		i+=1
	end
	call say
end

# aildb search INDEX -k LIMIT [-q QUERY] [-p PREFIX] [-l LANGUAGE] [-i MODEL]
fn search
	call argc as n
	if n<3
		call usage
	end
	# with --text it is the search of a directory, of src/index.aiw
	i=2
	while i<n
		call argv i as p m
		call texteq p m "--text" as is
		if is
			call textsearch
		end
		i+=1
	end
	call options 3 "kqpli"
	call opt 107 as kp kn
	ifz kp
		call usage
	end
	call textnum kp kn as k ok
	if (ok==0)|(k-1>0xfffffffe)
		call usage
	end
	call argv 2 as ip in
	call opt 113 as qp qn
	call opt 105 as mp mn
	call query ip in qp qn mp mn
	call hookmark 2
	call opt 112 as pp pn
	call opt 108 as lp ln
	call scan k pp pn lp ln ip in
	call hookmark 3
	call results
	call hookmark 4
	sys exit_group 0
end

# aildb check INDEX
fn check
	call argc as n
	if n!=3
		call usage
	end
	call argv 2 as p n
	call snapopen snap p n as r
	ifz r
		call snapcheck snap as r
	end
	if r
		call badsnap p n r
	end
	call summary
	call say
	sys exit_group 0
end

call hookmark 1
# A pipe that nobody reads is to be an error of the write, which has a
# line and the status of an I/O failure, and not the signal SIGPIPE,
# which would end the program without either.
store sigact 1
sys rt_sigaction 13 sigact 0 8
call argv 1 as cp cn
call texteq cp cn "build" as is
if is
	call build
end
call texteq cp cn "check" as is
if is
	call check
end
call texteq cp cn "search" as is
if is
	call search
end
call texteq cp cn "index" as is
if is
	call index
end
call usage
