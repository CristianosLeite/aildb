# src/main.aiw -- the commands of aildb. This is the one file that
# prints and exits; the functions of src/lib/ return what they found.
# docs/usage.md is the interface, and the exit statuses, one for each
# class of error, are the constants below.
#
# It is compiled into an executable by a file that uses lib/std/io.aiw
# and a file of hooks first: src/aildb.aiw for the one that is shipped.
#
# build and check are written; search is answered with the usage.
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "src/lib/crc.aiw"
use "src/lib/text.aiw"
use "src/lib/fmt.aiw"
use "src/lib/snap.aiw"
use "src/lib/meta.aiw"
use "src/lib/norm.aiw"
use "src/lib/pack.aiw"

const stusage 2         # wrong usage
const stinvalid 3       # an invalid snapshot or invalid input
const stio 4            # an I/O failure
const stbusy 5          # another build in progress for the destination
const stunsure 6        # published, durability not confirmed

buf msg 24              # the line that is being put together
buf snap 104            # the snapshot of the command
buf optv 416            # for each letter, the address and length of its value
buf text 24             # build: the metadata as it was read
buf recs 24             # its records
buf strs 24             # the strings of the snapshot
buf block 24            # everything before the vectors
buf tmp 24              # the path of the temporary file, with a NUL byte
buf dst 24              # the path of the destination, with a NUL byte
buf lck 24              # the path of the lock file, with a NUL byte
const pwrite 18
const flock 73

# print the usage on stderr and end the program
fn usage
	call eprint "usage: aildb build -o INDEX -v VECTORS -m METADATA -d DIMENSION -i MODEL [-r REVISION]
       aildb search INDEX -k LIMIT [-q QUERY] [-p PREFIX] [-l LANGUAGE] [-i MODEL]
       aildb check INDEX
"
	sys exit_group stusage
end

# end the program with the status st after the line of msg on stderr,
# which is the line itself if there was no memory to put it together
fn fail st
	call byaddb msg 10
	load msg as p
	load msg+8 as n
	call eprint p n
	sys exit_group st
end

# start the line of an error about the file at the path p n
fn about p n
	call bycut msg 0
	call byadd msg "aildb: "
	call byadd msg p n
	call byadd msg ": "
end

# add to msg the words for the error e of the kernel, a negative number
fn oserr e
	e=0-e
	if e==2
		tail byadd msg "no such file or directory"
	end
	if e==5
		tail byadd msg "input/output error"
	end
	if e==12
		tail byadd msg "out of memory"
	end
	if e==13
		tail byadd msg "permission denied"
	end
	if e==19
		tail byadd msg "not a file that can be mapped"
	end
	if e==20
		tail byadd msg "not a directory"
	end
	if e==21
		tail byadd msg "is a directory"
	end
	if e==27
		tail byadd msg "file too large"
	end
	if e==28
		tail byadd msg "no space left on device"
	end
	if e==36
		tail byadd msg "path too long"
	end
	call byadd msg "error "
	tail byaddn msg e
end

# end the program for the result r of snapopen or snapcheck on the path
# p n, which is not 0: an error of the kernel or an invalid snapshot
fn badsnap p n r
	call about p n
	ifslt r 0
		call byadd msg "cannot open: "
		call oserr r
		call fail stio
	end
	call snapwhy msg snap r
	call fail stinvalid
end

# print the line of msg on stdout, or end the program if it cannot be
# written
fn say
	load msg as p
	load msg+8 as n
	call print p n as ok
	ifz ok
		call bycut msg 0
		call byadd msg "aildb: cannot write the output"
		call fail stio
	end
end

# make msg the line about the open snapshot: its records, its dimension,
# its model identifier and its source revision
fn summary
	call bycut msg 0
	call byadd msg "{\"records\":"
	load snap+16 as x
	call byaddn msg x
	call byadd msg ",\"dimension\":"
	load snap+24 as x
	call byaddn msg x
	call byadd msg ",\"model\":"
	load snap+64 as p
	load snap+72 as n
	call fmtjson msg p n
	call byadd msg ",\"source_revision\":"
	load snap+80 as p
	load snap+88 as n
	if n
		call fmtjson msg p n
	else
		call byadd msg "null"
	end
	call byadd msg "}\n"
end

# Read the options of a command from the argument first on: each a "-"
# with one of the letters of the an bytes at ap, then its value. An
# argument that is no such option, a letter twice and a value that is
# missing are wrong usage.
fn options first ap an
	i=0
	while i<416
		store optv+i 0
		i+=8
	end
	call argc as c
	i=first
	while i<c
		call argv i as p n
		if n!=2
			call usage
		end
		loadb p as x
		loadb p+1 as y
		call textfind ap an y as k ok
		if (x!=45)|(ok==0)|(i+1>=c)
			call usage
		end
		load optv+(y-97)*16 as x
		if x
			call usage
		end
		call argv i+1 as p n
		store optv+(y-97)*16 p
		store optv+(y-97)*16+8 n
		i+=2
	end
end

# the value of the option with the letter x: its address and length, or
# 0 and 0 if it was not given
fn opt x
	load optv+(x-97)*16 as p
	load optv+(x-97)*16+8 as n
	ret p n
end

# write the n bytes at p to the file fd, in as many writes as it takes:
# 0, or the error of the kernel
fn writeall fd p n
	while n
		sys write fd p n as r
		ifz r
			r=-5
		end
		ifslt r 0
			if r!=-4
				ret r
			end
			r=0
		end
		p+=r
		n-=r
	end
	ret 0
end

# the same at the offset o of the file, wherever its position is
fn writeat fd p n o
	while n
		sys pwrite fd p n o as r
		ifz r
			r=-5
		end
		ifslt r 0
			if r!=-4
				ret r
			end
			r=0
		end
		p+=r
		n-=r
		o+=r
	end
	ret 0
end

# map the file at the path p n to read it: its address, its size and 0,
# or the error of the kernel as the third result. A file of no bytes has
# the address 0.
fn mapfile p n
	local st 144
	call fileopen p n 0 0 as fd
	ifslt fd 0
		ret 0 0 fd
	end
	sys fstat fd st as r
	ifslt r 0
		sys close fd
		ret 0 0 r
	end
	load st+48 as z
	a=0
	if z
		sys mmap 0 z 1 2 fd 0 as a
		if a>-4096
			sys close fd
			ret 0 0 a
		end
	end
	sys close fd
	ret a z 0
end

# end the program with the status st after the line of msg, and remove
# the temporary file of build first
fn giveup st
	load tmp as p
	load tmp+8 as n
	call fileunlink p n-1
	call fail st
end

# end the program for the error r of the kernel in doing what the wn
# bytes at wp say with the temporary file
fn tmperr wp wn r
	load tmp as p
	load tmp+8 as n
	call about p n-1
	call byadd msg wp wn
	call oserr r
	call giveup stio
end

# flush the directory of the file at the path p n to its device: 0, or
# the error of the kernel
fn syncdir p n
	i=n
	while i
		loadb p+i-1 as c
		jeq c 47 cut
		i-=1
	end
	label cut
	# no slash: this directory; a slash at the start alone: the root
	if i>1
		call fileopen p i-1 0x10000 0 as fd
	else
		if i
			call fileopen "/" 0x10000 0 as fd
		else
			call fileopen "." 0x10000 0 as fd
		end
	end
	ifslt fd 0
		ret fd
	end
	call hooksync fd 2 as r
	sys close fd
	ret r
end

# Take the lock of a build for the destination, an exclusive flock on
# the file of the path in lck, which is made if it is not there and
# never removed; it is held until the program ends. If another build
# holds it the program ends here with the status of that.
fn lock
	load lck as p
	load lck+8 as n
	n-=1
	call fileopen p n 0x41 420 as fd
	ifslt fd 0
		call about p n
		call byadd msg "cannot create: "
		call oserr fd
		call fail stio
	end
	# LOCK_EX and LOCK_NB
	sys flock fd 6 as r
	if r==-11
		load dst as p
		load dst+8 as n
		call about p n-1
		call byadd msg "another build is in progress"
		call fail stbusy
	end
	if r
		call about p n
		call byadd msg "cannot lock: "
		call oserr r
		call fail stio
	end
end

# Write the snapshot of build to the temporary file, flush it, validate
# it, put it in the place of the destination and flush the directory. block is everything before the vectors, vec
# the address of the count vectors of dim binary32 as they were given,
# and vp vn the path they came from, for the line of an error. Returns
# when the destination is the new snapshot, which snap then is, and its
# directory was flushed; the lock is held by the caller.
fn publish vec count dim vp vn
	load tmp as tp
	load tmp+8 as tn
	tn-=1
	call fileopen tp tn 0x241 420 as fd
	ifslt fd 0
		call about tp tn
		call byadd msg "cannot create: "
		call oserr fd
		call fail stio
	end
	load block as bp
	load block+8 as bn
	call writeall fd bp bn as r
	if r
		call tmperr "cannot write: " r
	end
	call hookstop 1
	# the doubles of one vector, and a megabyte or so of whole vectors as
	# they go to the file
	per=1048576/(dim*4)
	ifz per
		per=1
	end
	room=per*dim*4
	alloc dim*8 as q
	alloc room as w
	if (q==0)|(w==0)
		call tmperr "cannot write: " -12
	end
	crc=0
	fill=0
	i=0
	while i<count
		call normwide vec+i*dim*4 q dim as r
		if r
			call about vp vn
			call byadd msg "the vector of line "
			call byaddn msg i+1
			if r==normnan
				call byadd msg " has an element that is not finite"
			else
				call byadd msg " is all zeros"
			end
			call giveup stinvalid
		end
		call normround q w+fill dim
		fill+=dim*4
		if fill==room
			call crc32 crc w fill as crc
			call writeall fd w fill as r
			if r
				call tmperr "cannot write: " r
			end
			fill=0
		end
		i+=1
	end
	call crc32 crc w fill as crc
	call writeall fd w fill as r
	if r
		call tmperr "cannot write: " r
	end
	# the checksums are known now: the header once more
	call packseal block crc
	call writeat fd bp 128 0 as r
	if r
		call tmperr "cannot write: " r
	end
	# on the device before it is looked at and before it gets its name
	call hooksync fd 1 as r
	if r
		sys close fd
		call tmperr "cannot sync: " r
	end
	sys close fd as r
	if r
		call tmperr "cannot write: " r
	end
	# what was written must be a snapshot to the reader
	call snapopen snap tp tn as r
	ifz r
		call snapcheck snap as r
	end
	ifslt r 0
		call tmperr "cannot read back: " r
	end
	if r
		call about tp tn
		call byadd msg "written, and read back as no valid snapshot: "
		call snapwhy msg snap r
		call giveup stio
	end
	call hookstop 2
	load dst as dp
	load dst+8 as dn
	sys rename tp dp as r
	if r
		call tmperr "cannot rename to the destination: " r
	end
	call hookstop 3
	# the new name is durable when its directory is: until then a loss of
	# power may bring the old snapshot back
	call syncdir dp dn-1 as r
	if r
		call about dp dn-1
		call byadd msg "published, but its directory could not be synced, so it may not survive a loss of power: "
		call oserr r
		call fail stunsure
	end
end

# aildb build -o INDEX -v VECTORS -m METADATA -d DIMENSION -i MODEL [-r REVISION]
fn build
	call options 2 "ovmdir"
	call opt 111 as op on
	call opt 118 as vp vn
	call opt 109 as mp mn
	call opt 100 as dp dn
	call opt 105 as ip in
	call opt 114 as rp rn
	if (op==0)|(vp==0)|(mp==0)|(dp==0)|(ip==0)
		call usage
	end
	call textnum dp dn as dim ok
	if (ok==0)|(dim-1>65535)
		call usage
	end
	call byadd dst op on as a
	call byaddb dst 0 as b
	call byadd tmp op on as c
	call byadd tmp ".tmp\0" as d
	call byadd lck op on as e
	call byadd lck ".lock\0" as f
	call bycut msg 0
	ifz a&b&c&d&e&f
		call byadd msg "aildb: out of memory"
		call fail stio
	end
	call lock
	call bycut msg 0
	call textvalid ip in as ok
	if (in-1>254)|(ok==0)
		call byadd msg "aildb: the model identifier is empty, longer than 255 bytes or not valid text"
		call fail stinvalid
	end
	call byadd strs ip in
	ro=0
	if rp
		call textvalid rp rn as ok
		if (rn-1>254)|(ok==0)
			call byadd msg "aildb: the source revision is empty, longer than 255 bytes or not valid text"
			call fail stinvalid
		end
		ro=in
		call byadd strs rp rn
	end
	call fileread mp mn text as r
	ifslt r 0
		call about mp mn
		call byadd msg "cannot read: "
		call oserr r
		call fail stio
	end
	load text as p
	load text+8 as n
	call metaparse p n recs strs as count why
	if why
		call about mp mn
		call byadd msg "line "
		call byaddn msg count
		call byadd msg ": "
		call metawhy msg why
		if why==metamem
			call fail stio
		end
		call fail stinvalid
	end
	call mapfile vp vn as vec size r
	ifslt r 0
		call about vp vn
		call byadd msg "cannot read: "
		call oserr r
		call fail stio
	end
	if size!=count*dim*4
		call about vp vn
		call byadd msg "holds "
		call byaddn msg size
		call byadd msg " bytes, and "
		call byaddn msg count
		call byadd msg " records of "
		call byaddn msg dim
		call byadd msg " dimensions are "
		call byaddn msg count*dim*4
		call fail stinvalid
	end
	call packmeta block dim recs strs 0 in ro rn as ok
	ifz ok
		call byadd msg "aildb: out of memory"
		call fail stio
	end
	call publish vec count dim vp vn
	call summary
	call say
	sys exit_group 0
end

# aildb check INDEX
fn check
	call argc as n
	if n!=3
		call usage
	end
	call argv 2 as p n
	call snapopen snap p n as r
	ifz r
		call snapcheck snap as r
	end
	if r
		call badsnap p n r
	end
	call summary
	call say
	sys exit_group 0
end

call argv 1 as cp cn
call texteq cp cn "build" as is
if is
	call build
end
call texteq cp cn "check" as is
if is
	call check
end
call usage
