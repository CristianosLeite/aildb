# src/lib/provider.aiw -- the embedding provider of an index: the request
# that asks it for the vectors of texts and the reading of its answer.
# docs/provider.md has the protocol. A request is one of two operations,
# the texts of documents or the text of a query, so that a provider can
# treat the two differently; the answer is checked here, where it enters
# aildb: as many vectors as texts, each with the index of its text, of
# the dimension of the configuration, of finite binary32, and none of
# zeros alone, which is what build asks of a vector.
#
# A provider is a command (docs/provider.md): provdocs and provquery
# start it once for each request, with the request as its stdin, wait
# for it no longer than the configuration allows, and read the answer it
# printed. What it reads and writes are files in memory, so that it never
# waits for aildb to read and aildb never for it.
#
# The configuration is one of src/lib/config.aiw. The functions return
# what they found and print nothing. Every name of this file starts with
# "prov"; a program has no var of such a name.
use "lib/std/io.aiw"
use "lib/std/bytes.aiw"
use "lib/std/file.aiw"
use "lib/std/proc.aiw"
use "lib/std/num.aiw"
use "lib/std/json.aiw"
use "src/lib/text.aiw"
use "src/lib/norm.aiw"
use "src/lib/config.aiw"

# the version of the protocol, the member "aildb" of a request and of an
# answer
const provversion 1

# the two operations
const provdocuments 0
const provquery 1

# why an answer is none
const provjson 1        # not one object of JSON
const provother 2       # no member "aildb" with the version of the request
const provshape 3       # no array "embeddings" of objects with an index and a vector
const provcount 4       # not as many vectors as texts
const provorder 5       # a vector whose index is not that of its place
const provlong 6        # a vector that has not the elements of the dimension
const provvalue 7       # an element that is no number, or none that is finite as a binary32
const provzero 8        # a vector of zeros
const provmem 9         # no memory
# and why there is no answer, each with the result of procwait beside it
const provstart 10      # the command could not be started
const provexit 11       # it ended with a status that is not 0
const provsignal 12     # a signal ended it
const provtime 13       # it took longer than the configuration allows
const provtext 14       # a text that is no string of JSON or not well-formed UTF-8

const provmemfd 319
const provlseek 8
data provname "aildb-provider\0"

# the doubles of one vector, for the check that build makes
buf provwide 24
# a request, the answer to it, and the addresses of the arguments
buf provreq 24
buf provresp 24
buf provav 24

# Add to the bytes buffer provb the request of the operation provop to
# the provider of the configuration provc, one line of JSON. For
# provdocuments the provn bytes at provp are the texts, each a string of
# JSON on a line of its own, as the chunker writes them; for provquery
# they are the bytes of the query itself, well-formed UTF-8. 1, or 0
# without memory, and then the buffer may have a part of the request.
fn provrequest provb provc provop provp provn
	call byadd provb "{\"aildb\":"
	call byaddn provb provversion
	if provop==provquery
		call byadd provb ",\"op\":\"query\",\"model\":"
	else
		call byadd provb ",\"op\":\"documents\",\"model\":"
	end
	call confstr provc confmodel as provq provm
	call jsonadds provb provq provm
	call byadd provb ",\"revision\":"
	call confstr provc confrev as provq provm
	call jsonadds provb provq provm
	call byadd provb ",\"dimension\":"
	load provc+confdim as provv
	call byaddn provb provv
	call byadd provb ",\"settings\":{"
	provlp=0
	provln=0
	provk=0
	label each
	call confnext provc provlp provln as provlp provln provq provm provok
	if provok
		if provk
			call byaddb provb 44
		end
		call jsonadds provb provlp provln
		call byaddb provb 58
		call jsonadds provb provq provm
		provk+=1
		jmp each
	end
	call byadd provb "},\"texts\":["
	if provop==provquery
		call jsonadds provb provp provn
	else
		provk=0
		while provn
			call textline provp provn as provl provok
			if provk
				call byaddb provb 44
			end
			call byadd provb provp provl
			provk+=1
			provp+=provl+provok
			provn-=provl+provok
		end
	end
	tail byadd provb "]}\n"
end

# the elements of the array of the provn bytes at provp read as a vector
# of provdim binary32 written at provout, where there is room for them:
# 0 or a reason
fn provvector provp provn provdim provout
	provq=provp+1
	provk=0
	label number
	call jsonelem provq provp+provn as provf provl provkind provq
	if provkind
		if provkind!=4
			ret provvalue
		end
		if provk>=provdim
			ret provlong
		end
		call numdouble provf provl as provd provok
		f8to4 provd as provw
		# finite as a binary32 too: its exponent is not all ones
		if (provok==0)|((provw>>23&255)==255)
			ret provvalue
		end
		store4 provout+provk*4 provw
		provk+=1
		jmp number
	end
	if provk!=provdim
		ret provlong
	end
	store provwide+8 0
	call byneed provwide provdim*8 as provok
	ifz provok
		ret provmem
	end
	load provwide as provq
	call normwide provout provq provdim as provr
	if provr==normzero
		ret provzero
	end
	if provr
		ret provvalue
	end
	ret 0
end

# Read the provn bytes at provp, the answer of a provider to a request
# of provk texts for vectors of the dimension provdim: the vectors are
# added to the bytes buffer provout, provk times provdim binary32 in the
# order of the texts, as build takes them. 0, or a reason, a constant
# above, after which the buffer holds what it held.
fn provparse provp provn provdim provk provout
	load provout+8 as provbase
	call byneed provout provk*provdim*4 as provok
	ifz provok
		ret provmem
	end
	call jsonvalue provp provn as prova provan provkind
	if provkind!=7
		ret provjson
	end
	call jsonget prova provan "aildb" as provq provm provkind
	if provkind!=4
		ret provother
	end
	call numint provq provm as provv provok
	if (provok==0)|(provv!=provversion)
		ret provother
	end
	call jsonget prova provan "embeddings" as prove proven provkind
	if provkind!=6
		ret provshape
	end
	provq=prove+1
	provi=0
	label vector
	call jsonelem provq prove+proven as provx provxn provkind provq
	if provkind
		if provkind!=7
			ret provshape
		end
		if provi>=provk
			ret provcount
		end
		call jsonget provx provxn "index" as provf provl provkind
		if provkind!=4
			ret provshape
		end
		call numint provf provl as provv provok
		if (provok==0)|(provv!=provi)
			ret provorder
		end
		call jsonget provx provxn "vector" as provf provl provkind
		if provkind!=6
			ret provshape
		end
		load provout as provo
		call provvector provf provl provdim provo+provbase+provi*provdim*4 as provr
		if provr
			ret provr
		end
		provi+=1
		jmp vector
	end
	if provi!=provk
		ret provcount
	end
	store provout+8 provbase+provk*provdim*4
	ret 0
end

# a descriptor of a file in memory with the provn bytes at provp, placed
# at its start, or a negative number
fn provfile provp provn
	sys provmemfd provname 1 as provfd
	ifslt provfd 0
		ret provfd
	end
	if provn
		call fdwrite provfd provp provn as provok
		ifz provok
			sys close provfd
			ret 0-5
		end
		sys provlseek provfd 0 0
	end
	ret provfd
end

# Run the command of the configuration provc with the provn bytes at
# provp as its stdin, for no longer than the configuration allows: what
# procwait gives, an exit status, a signal negated or -1000 for a command
# that was killed when its time was over; or -2000 if it could not be
# started. What it printed is then the bytes buffer provout and what it
# said the bytes buffer proverr, both emptied first.
fn provrun provc provp provn provout proverr
	call bycut provout 0
	call bycut proverr 0
	call confargs provc as provq provk
	call bycut provav 0
	call byneed provav provk*8+8 as provok
	ifz provok
		ret 0-2000
	end
	load provav as prova
	provi=0
	while provi<provk
		store prova+provi*8 provq
		call strlen provq as provl
		provq+=provl+1
		provi+=1
	end
	store prova+provk*8 0
	ifz provk
		ret 0-2000
	end
	call provfile provp provn as provin
	call provfile 0 0 as provo
	call provfile 0 0 as prove
	provst=0-2000
	ifsge provin|provo|prove 0
		call procstart prova provin provo prove as provpid
		ifsge provpid 0
			load provc+conftime as provms
			call procwait provpid provms as provst
		end
		sys provlseek provo 0 0
		sys provlseek prove 0 0
		call filereadfd provo provout
		call filereadfd prove proverr
	end
	ifsge provin 0
		sys close provin
	end
	ifsge provo 0
		sys close provo
	end
	ifsge prove 0
		sys close prove
	end
	ret provst
end

# One request of the operation provop for the provk texts of the provn
# bytes at provp, as provrequest takes them: the vectors are added to
# the bytes buffer provout. The results are 0 and 0; or a reason and what
# procwait gave for the command, after which provout holds what it held
# and the bytes buffer proverr what the command said.
fn provask provc provop provp provn provk provout proverr
	call bycut provreq 0
	call provrequest provreq provc provop provp provn as provok
	ifz provok
		ret provmem 0
	end
	load provreq as provq
	load provreq+8 as provm
	call provrun provc provq provm provresp proverr as provst
	if (provst==0-2000)|(provst==127)
		ret provstart provst
	end
	if provst==0-1000
		ret provtime provst
	end
	ifslt provst 0
		ret provsignal provst
	end
	if provst
		ret provexit provst
	end
	load provresp as provq
	load provresp+8 as provm
	load provc+confdim as provdim
	call provparse provq provm provdim provk provout as provw
	ret provw 0
end

# The vectors of the provk texts of documents in the provn bytes at
# provp, each a string of JSON on a line of its own, as the chunker
# writes them: asked of the provider of the configuration provc in
# requests of as many texts as the configuration allows, and added to
# the bytes buffer provout, provk times the dimension binary32 in the
# order of the texts. The results are as those of provask; after a
# reason provout holds what it held.
fn provdocs provc provp provn provk provout proverr
	load provout+8 as provbase
	load provc+confbatch as provmax
	while provk
		# the lines of this request
		provi=0
		provm=0
		while (provi<provk)&(provi<provmax)
			call textline provp+provm provn-provm as provl provok
			call jsonvalue provp+provm provl as prova provan provkind
			if (provok==0)|(provkind!=5)
				store provout+8 provbase
				ret provtext 0
			end
			provm+=provl+1
			provi+=1
		end
		call provask provc provdocuments provp provm provi provout proverr as provw provst
		if provw
			store provout+8 provbase
			ret provw provst
		end
		provp+=provm
		provn-=provm
		provk-=provi
	end
	ret 0 0
end

# The vector of the query of the provn bytes at provp, asked of the
# provider of the configuration provc and added to the bytes buffer
# provout: the results are as those of provask. A query that is not
# well-formed UTF-8 is the reason provtext, and nothing is asked.
fn provquerytext provc provp provn provout proverr
	call textutf8 provp provn as provok
	ifz provok
		ret provtext 0
	end
	call provask provc provquery provp provn 1 provout proverr as provw provst
	ret provw provst
end

# Add to the bytes buffer provb what the reason provw says, with provst,
# what procwait gave, and the first line of the proverr bytes at provq
# that the command said, 400 bytes of it at most: 1, or 0 without memory.
fn provtell provb provw provst provq proverr
	if provw<provstart
		tail provwhy provb provw
	end
	if provw==provtext
		tail provwhy provb provw
	end
	provok=1
	if provw==provstart
		call byadd provb "the provider could not be started" as provok
	end
	if provw==provexit
		call byadd provb "the provider ended with the status "
		call byaddn provb provst as provok
	end
	if provw==provsignal
		call byadd provb "the provider was ended by the signal "
		call byaddn provb 0-provst as provok
	end
	if provw==provtime
		call byadd provb "the provider took longer than it may" as provok
	end
	provl=0
	label more
	if provl<proverr
		loadb provq+provl as provc
		if (provc!=10)&(provl<400)
			provl+=1
			jmp more
		end
	end
	# not half a character
	label back
	if (provl>0)&(provl<proverr)
		loadb provq+provl as provc
		if provc&0xc0==0x80
			provl-=1
			jmp back
		end
	end
	if provl
		call byadd provb ": "
		call byadd provb provq provl as provok
	end
	ret provok
end

# add to the bytes buffer provb what the reason provw says of an answer,
# in words: 1, or 0 without memory
fn provwhy provb provw
	if provw==provjson
		tail byadd provb "the answer is not one object of JSON"
	end
	if provw==provother
		tail byadd provb "the answer is not of version 1 of the protocol"
	end
	if provw==provshape
		tail byadd provb "the answer has no embeddings, each with an index and a vector"
	end
	if provw==provcount
		tail byadd provb "the answer has not as many vectors as there were texts"
	end
	if provw==provorder
		tail byadd provb "a vector of the answer is not at the place of its text"
	end
	if provw==provlong
		tail byadd provb "a vector of the answer has not the dimension of the index"
	end
	if provw==provvalue
		tail byadd provb "a vector of the answer has an element that is no finite number"
	end
	if provw==provzero
		tail byadd provb "a vector of the answer is all zeros"
	end
	if provw==provmem
		tail byadd provb "no memory"
	end
	if provw==provtext
		tail byadd provb "a text that is not well-formed UTF-8"
	end
	ret 1
end
