# aildb -- a local, file-based vector search engine.
#
# The source of the executable that is shipped, build/aildb: the
# commands of src/main.aiw with the hooks of src/hook.aiw, which do
# nothing. The tests build a second executable from the same
# src/main.aiw with hooks that stop and fail (tests/lib/stops.aiw).
use "lib/std/io.aiw"
use "src/hook.aiw"
use "src/main.aiw"
