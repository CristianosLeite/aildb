# discovery
> {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"test","version":"0"}}}
< {"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-11-25","capabilities":{"tools":{}},"serverInfo":{"name":"aildb-mcp","version":"0.1.1"},"instructions":"Semantic search over an index of source files: the tool search returns paths and line ranges, at the revision it names, for a query in words."}}
> {"jsonrpc":"2.0","method":"notifications/initialized"}
> {"jsonrpc":"2.0","id":2,"method":"tools/list"}
< {"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"search","description":"Find the source locations that are nearest in meaning to a query in words, in a local index of a repository. Returns paths with line ranges, the best first, and the revision of the sources they are of. For a PDF file, a path that ends in .pdf, start_line and end_line are the number of the page.","inputSchema":{"type":"object","properties":{"query":{"type":"string","description":"What to look for, in words: a question or a description of the code or text."},"k":{"type":"integer","minimum":1,"maximum":50,"default":10,"description":"The largest number of results."},"path_prefix":{"type":"string","description":"Only locations whose path starts with these bytes, as lib/std/."},"language":{"type":"string","description":"Only locations of this language, as the index names it."}},"required":["query"],"additionalProperties":false},"outputSchema":{"type":"object","properties":{"model":{"type":"string","description":"The embedding model of the snapshot."},"source_revision":{"type":["string","null"],"description":"The revision of the sources the snapshot was built from: open the lines at this revision."},"hits":{"type":"array","description":"The locations, the best first.","items":{"type":"object","properties":{"rank":{"type":"integer"},"path":{"type":"string"},"start_line":{"type":"integer"},"end_line":{"type":"integer"},"score":{"type":"number","description":"The cosine similarity, six digits."},"score_bits":{"type":"string","description":"The same as the bits of a binary64, in hexadecimal."}},"required":["rank","path","start_line","end_line","score","score_bits"]}}},"required":["model","source_revision","hits"]}}]}}

# calls, and the command for the same vectors
> {"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"search","arguments":{"query":"alpha"}}}
< {"jsonrpc":"2.0","id":3,"result":{"content":[{"type":"text","text":"{\"model\":\"m\",\"source_revision\":\"rev1\",\"hits\":[{\"rank\":1,\"score\":1.000000,\"score_bits\":\"3ff0000000000000\",\"path\":\"a.aiw\",\"start_line\":1,\"end_line\":10},{\"rank\":2,\"score\":0.600000,\"score_bits\":\"3fe3333340000000\",\"path\":\"lib/c.aiw\",\"start_line\":20,\"end_line\":40},{\"rank\":3,\"score\":0.000000,\"score_bits\":\"0000000000000000\",\"path\":\"docs/b.md\",\"start_line\":5,\"end_line\":9}]}"}],"structuredContent":{"model":"m","source_revision":"rev1","hits":[{"rank":1,"score":1.000000,"score_bits":"3ff0000000000000","path":"a.aiw","start_line":1,"end_line":10},{"rank":2,"score":0.600000,"score_bits":"3fe3333340000000","path":"lib/c.aiw","start_line":20,"end_line":40},{"rank":3,"score":0.000000,"score_bits":"0000000000000000","path":"docs/b.md","start_line":5,"end_line":9}]},"isError":false}}
$ aildb search s.idx -k 10
{"source_revision":"rev1","model":"m"}
{"rank":1,"score":1.000000,"score_bits":"3ff0000000000000","path":"a.aiw","start_line":1,"end_line":10}
{"rank":2,"score":0.600000,"score_bits":"3fe3333340000000","path":"lib/c.aiw","start_line":20,"end_line":40}
{"rank":3,"score":0.000000,"score_bits":"0000000000000000","path":"docs/b.md","start_line":5,"end_line":9}
> {"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"search","arguments":{"query":"both of them","k":2}}}
< {"jsonrpc":"2.0","id":4,"result":{"content":[{"type":"text","text":"{\"model\":\"m\",\"source_revision\":\"rev1\",\"hits\":[{\"rank\":1,\"score\":1.000000,\"score_bits\":\"3ff0000006666666\",\"path\":\"lib/c.aiw\",\"start_line\":20,\"end_line\":40},{\"rank\":2,\"score\":0.800000,\"score_bits\":\"3fe9999995c28f5d\",\"path\":\"docs/b.md\",\"start_line\":5,\"end_line\":9}]}"}],"structuredContent":{"model":"m","source_revision":"rev1","hits":[{"rank":1,"score":1.000000,"score_bits":"3ff0000006666666","path":"lib/c.aiw","start_line":20,"end_line":40},{"rank":2,"score":0.800000,"score_bits":"3fe9999995c28f5d","path":"docs/b.md","start_line":5,"end_line":9}]},"isError":false}}
