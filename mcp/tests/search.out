# the model
> {"jsonrpc":"2.0","id":14,"method":"tools/call","params":{"name":"search","arguments":{"query":"refuse"}}}
< {"jsonrpc":"2.0","id":14,"result":{"content":[{"type":"text","text":"the embedding model refused: status 500 {\"error\":\"the model is not loaded\"}"}],"isError":true}}
> {"jsonrpc":"2.0","id":15,"method":"tools/call","params":{"name":"search","arguments":{"query":"junk"}}}
< {"jsonrpc":"2.0","id":15,"result":{"content":[{"type":"text","text":"the embedding model answered without a vector"}],"isError":true}}
> {"jsonrpc":"2.0","id":16,"method":"tools/call","params":{"name":"search","arguments":{"query":"three"}}}
< {"jsonrpc":"2.0","id":16,"result":{"content":[{"type":"text","text":"the search failed: aildb: standard input: holds more than 8 bytes, and a query of 2 dimensions is 8"}],"isError":true}}

# the snapshot is replaced: another revision, two records
> {"jsonrpc":"2.0","id":17,"method":"tools/call","params":{"name":"search","arguments":{"query":"both"}}}
< {"jsonrpc":"2.0","id":17,"result":{"content":[{"type":"text","text":"{\"model\":\"m\",\"source_revision\":\"rev2\",\"hits\":[{\"rank\":1,\"score\":0.800000,\"score_bits\":\"3fe9999995c28f5d\",\"path\":\"docs/b.md\",\"start_line\":5,\"end_line\":9},{\"rank\":2,\"score\":0.600000,\"score_bits\":\"3fe333333851eb82\",\"path\":\"a.aiw\",\"start_line\":1,\"end_line\":10}]}"}],"structuredContent":{"model":"m","source_revision":"rev2","hits":[{"rank":1,"score":0.800000,"score_bits":"3fe9999995c28f5d","path":"docs/b.md","start_line":5,"end_line":9},{"rank":2,"score":0.600000,"score_bits":"3fe333333851eb82","path":"a.aiw","start_line":1,"end_line":10}]},"isError":false}}

