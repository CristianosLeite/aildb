{"rank":2,"score":0.000000,"score_bits":"0000000000000000","path":"a.aiw","start_line":1,"end_line":10}
> {"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"search","arguments":{"query":"beta","path_prefix":"lib/","language":"ail"}}}
