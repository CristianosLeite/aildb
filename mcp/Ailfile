# aildb-mcp: a Model Context Protocol server that searches an index of
# aildb for a coding agent (docs/mcp.md of aildb): a directory, through
# the command aildb search --text, or a snapshot. The server SDK is the
# module mcp of the package ail-extensions, named by its address and a
# version; Ailfile.lock has the revision of that version.
name aildb-mcp
version 0.1.2
ail 0.2.1

bin aildb-mcp src/main.aiw
# built for the tests: an embedding service that answers from a table
testbin embed-fake tests/lib/fake.aiw
# and a command run with a limit of open descriptors
testbin nofile tests/lib/nofile.aiw
dep aildb ..
dep ail-extensions 0.1.2 https://github.com/CristianosLeite/ail-extensions.git
