# aildb-mcp: a Model Context Protocol server that searches a snapshot of
# aildb for a coding agent (docs/mcp.md of aildb). The server SDK is the
# module mcp of the repository ail-extensions, named here by its
# directory beside this repository until it has an address of its own.
name aildb-mcp
version 0.1.0
ail 0.1.0

bin aildb-mcp src/main.aiw
# built for the tests: an embedding service that answers from a table
testbin embed-fake tests/lib/fake.aiw
# and a command run with a limit of open descriptors
testbin nofile tests/lib/nofile.aiw
dep aildb ..
dep mcp ../../ail-extensions/mcp
