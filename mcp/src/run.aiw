# src/run.aiw -- a command run for aildb-mcp, with what it reads and
# writes in files in memory: the arguments are put together with arg,
# run starts the command and waits for it, and so and se then hold what
# it printed and what it said. A program that uses it uses
# lib/std/io.aiw, lib/std/bytes.aiw, lib/std/file.aiw and
# lib/std/proc.aiw first. It is a file of its own so that a test can
# call run without the server around it (tests/run.aiw).

const memfd 319
const lseek 8
buf zs 8192             # the arguments of the command, a NUL after each
buf av 104              # their addresses
buf so 24               # what the command printed
buf se 24               # and what it said
data mname "aildb\0"
# zn: the bytes of zs that are taken; zbad: 1 if an argument of the
# command had no room; ms: the milliseconds a command may take, 0 for no
# limit
var zn zbad ms

# Add the n bytes at p to the arguments of the command as number k; the
# number 0 starts a command. An argument that zs or av has no room for
# is not added, and run then starts nothing.
fn arg k p n
	ifz k
		zn=0
		zbad=0
	end
	if (k>11)|(n>8191)|(zn+n+1>8192)
		zbad=1
		ret 0
	end
	call bycopy zs+zn p n
	storeb zs+zn+n 0
	store av+k*8 zs+zn
	store av+k*8+8 0
	zn+=n+1
end

# A descriptor of a file in memory with the n bytes at p, placed at its
# start, or a negative number.
fn memfile p n
	sys memfd mname 1 as fd
	ifslt fd 0
		ret fd
	end
	if n
		call fdwrite fd p n as ok
		ifz ok
			rt close fd
			ret 0-5
		end
		sys lseek fd 0 0
	end
	ret fd
end

# Run the command of av with the n bytes at p as its stdin: its status
# as procwait gives it, with so and se what it wrote; -1000 if it took
# longer than ms, -2000 if it could not be started, and -3000 if its
# arguments had no room, after which nothing was started.
fn run p n
	# nothing of the command before this one is left to be read as
	# what this one said, should it not be started
	call bycut so 0
	call bycut se 0
	if zbad
		ret 0-3000
	end
	call memfile p n as in
	call memfile 0 0 as out
	call memfile 0 0 as err
	ifslt in|out|err 0
		# the ones that were made are closed: the server goes on
		ifsge in 0
			rt close in
		end
		ifsge out 0
			rt close out
		end
		ifsge err 0
			rt close err
		end
		ret 0-2000
	end
	call procstart av in out err as pid
	st=0-2000
	ifsge pid 0
		call procwait pid ms as st
	end
	sys lseek out 0 0
	sys lseek err 0 0
	call filereadfd out so
	call filereadfd err se
	rt close in
	rt close out
	rt close err
	ret st
end

# the first line of what the command said, for a message: its address
# and length
fn said
	load se as p
	load se+8 as n
	i=0
	label more
	if i<n
		loadb p+i as c
		if c!=10
			i+=1
			jmp more
		end
	end
	ret p i
end

# the last line of what the command said that has a byte on it: its
# address and length. A command that says several things says why it
# failed last.
fn saidlast
	load se as p
	load se+8 as n
	label trim
	if n
		loadb p+n-1 as c
		if c==10
			n-=1
			jmp trim
		end
	end
	i=n
	label back
	if i
		loadb p+i-1 as c
		if c!=10
			i-=1
			jmp back
		end
	end
	ret p+i n-i
end
